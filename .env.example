# ============================================================
# K.D. Constructions — environment
# ------------------------------------------------------------
# Copy this file to ".env" and fill in real values. The .env file holds
# secrets and is git-ignored — never commit it.
# ============================================================

# The dev server port. 4321 is taken by another project on this machine.
PORT=4322

# Absolute origin for every canonical URL, og:image, the JSON-LD, the
# Sitemap line in /robots.txt and every <loc> in /sitemap.xml. Leave empty
# in development to fall back to http://localhost:<PORT>. In production it
# is REQUIRED: `npm run build:release` refuses to build while it is empty,
# http, or localhost (scripts/check-site-url.mjs). An https origin only,
# no path, no trailing slash. Production, live since 11 Nov 2026:
# https://kdconstructions.net (the bare domain; nginx sends www to it).
PUBLIC_SITE_URL=

# A test copy of the site: set to 1 and every response says
# X-Robots-Tag: noindex and /robots.txt disallows everything
# (src/lib/staging.ts). Read at request time: edit and restart, no
# rebuild. MUST be empty or removed on production, which is indexed.
SITE_NOINDEX=

# ============================================================
# MySQL
# ------------------------------------------------------------
# The database name here must match the one in db/migrate.sql. That file
# creates and updates the schema; an administrator runs it on every
# deploy, because DB_USER (kd_app on a server) may only SELECT and
# INSERT, plus DELETE on job_applications and UPDATE of mail_status on
# job_applications and enquiries — the grants are listed at its foot.
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kd_construction

# ============================================================
# In-page editor sign-in
# ------------------------------------------------------------
# All three are REQUIRED. src/lib/edit-auth.ts throws at import time if
# EDIT_SECRET is missing, which takes /api/content down with it — that is
# deliberate. Generate each with:
#     openssl rand -base64 32 | tr -d '=+/' | cut -c1-40
# ============================================================

# The secret second path segment: the editor signs in at /studio/<slug>.
# Long and random, not a word. Nothing links to it.
EDIT_LOGIN_SLUG=

# What the editor actually types into the box. This is the protection;
# the slug above only decides who finds the box.
EDIT_PASSPHRASE=

# HMAC key for the seven-day session cookie. 32+ random bytes. Changing
# this or EDIT_PASSPHRASE signs everybody out.
EDIT_SECRET=

# Studio photo uploads (MEDIA_DIR/gallery) and the resumes sent from
# /careers (MEDIA_DIR/applications, never served publicly) are stored
# here. Outside the repo and dist/ so deploys never touch them; back this
# folder up.
MEDIA_DIR=

# ============================================================
# Careers applications by email, through Resend (src/lib/mailer.ts)
# ------------------------------------------------------------
# The /careers "Apply here" form saves each application, then emails it,
# resume attached, to CAREERS_MAIL_TO through Resend's HTTP API. Resend
# sends from updates.kdconstructions.net, a domain verified in Resend, so
# CAREERS_MAIL_FROM must be an address on it. Read at send time: edit and
# restart, no rebuild.
#
# RESEND_API_KEY: the API key from the Resend dashboard (it starts re_).
# A secret: only ever in .env, never in a commit, a log or a chat. Leave it
# empty and nothing is emailed: applications are only kept in
# /studio/applications, each marked "Not sent, email is not set up".
RESEND_API_KEY=

# Who gets each application. Several addresses: separate them with commas.
CAREERS_MAIL_TO=hr@kdconstructions.net

# The sender HR sees. The address must be on updates.kdconstructions.net.
CAREERS_MAIL_FROM="K.D. Constructions Careers <careers@updates.kdconstructions.net>"

# Development only. 1 = build each email and print it to the log instead
# of sending it (the resume as its size, not its bytes). The log then
# holds the applicant's details, so never set this on production.
CAREERS_MAIL_DRY_RUN=

# ============================================================
# Enquiries from /contact, by email through Resend (src/lib/enquiry-mail.ts)
# ------------------------------------------------------------
# The enquiry form on /contact saves each enquiry (/studio/enquiries), then
# emails it to ENQUIRY_MAIL_TO through Resend with the same RESEND_API_KEY
# as the careers email above; there is no second key. Read at send or
# request time: edit and restart, no rebuild.

# Who gets each enquiry. Several addresses: separate them with commas, e.g.
# infra@kdconstructions.net (the address the Business enquiries card on
# /contact shows). NO DEFAULT: left empty, enquiries are saved and listed in
# /studio/enquiries but nobody is emailed ("No recipients are set").
ENQUIRY_MAIL_TO=

# The sender K.D. sees. The address must be on updates.kdconstructions.net,
# the domain verified in Resend. Empty: the line below.
ENQUIRY_MAIL_FROM="K.D. Constructions Website <enquiries@updates.kdconstructions.net>"

# Development only. 1 = build each enquiry's email and print it to the log
# instead of sending it. The log then holds the sender's details, so never
# set this on production.
ENQUIRY_MAIL_DRY_RUN=

# How many enquiries one address may send in an hour (src/lib/enquiries.ts).
# Empty or not a number: 5. Invalid ones count too, so a script cannot keep
# trying. All addresses together are held to 200 a day, a fixed limit.
ENQUIRY_RATE_PER_HOUR=
