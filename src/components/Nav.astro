---
/* ============================================================
   Fixed site nav — 88px, ink, 1px bottom border
   ------------------------------------------------------------
   Fixed, so the first band of every page has to clear it. The hero does
   that with pt-144. See DESIGN-SYSTEM.md §7.

   The active link is mint with a 1px mint bottom border. That border is
   the only underline in the design — never text-decoration.

   THE COPY IS SHARED ACROSS PAGES; THE SLOT KEYS ARE NOT. The labels
   come from home.ts on every page — one definition, so they cannot
   drift — but a key's first segment is the page it renders on
   (DESIGN-SYSTEM §9), so the caller passes `page` and the first link is
   `home.nav.links.0.label` on `/` and `about.nav.links.0.label` on
   `/about`. Nothing is lost by that: content_edits is keyed on
   (page_path, edit_key) and /api/content returns one path's rows, so a
   nav edit made on one page was never going to paint on another.

   MOBILE, per DESIGN-SYSTEM.md §10: collapses to a drawer below 900px —
   the logo stays in the bar; the links and the CTA move into a panel
   under it, toggled by a hamburger button. The two link lists (bar and
   drawer) are separate `.map()` calls over the same `nav.links` rather
   than one shared render function, matching how this codebase already
   repeats markup per instance instead of abstracting a one-off.
   ============================================================ */
import { home } from "../data/home";

interface Props {
  /** First segment of every slot key this component writes. */
  page?: string;
  /** Transparent over the hero on desktop (homepage only). */
  overlay?: boolean;
}

const { page = "home", overlay = false } = Astro.props;

const { nav } = home;
const here = Astro.url.pathname.replace(/(.)\/+$/, "$1");

/* Links with a `parent` render in that link's drop-down instead of on
   the bar. `i` is kept alongside so the edit key stays the link's own
   array index. */
const indexed = nav.links
  .map((link, i) => ({ link, i }))
  .filter(({ link }) => !link.retired);
/* A drop-down's links run in array order unless one sets `order`. */
const childrenOf = (href: string) =>
  indexed
    .filter(({ link }) => link.parent === href)
    .sort((a, b) => (a.link.order ?? a.i) - (b.link.order ?? b.i));
/* The bar's links, left to right by `order` — array order is edit-key
   order and cannot be changed (home.ts). */
const topLevel = indexed
  .filter(({ link }) => !link.parent)
  .sort((a, b) => (a.link.order ?? a.i) - (b.link.order ?? b.i));
/* A link is current on its own page and on any page beneath it, so
   Projects stays lit on /projects/<slug>. Home matches only itself. */
const isHere = (href: string) =>
  here === href || (href !== "/" && here.startsWith(href + "/"));
---

{/* OVERLAY (homepage, ≥1080px only): while the hero is under the bar,
    `data-transparent` swaps the ink for `--kd-nav-overlay` and drops the
    border, so the photograph runs to the top of the window. The script
    below removes it once the hero has scrolled out from under the bar.
    It is rendered on, so the first paint is already transparent. Below
    1080 the attribute does nothing — phones keep the solid bar. */}
<header
  class="fixed top-0 inset-x-0 z-50 bg-kd-ink border-b border-b-kd-nav-border min-[1080px]:data-transparent:[background:var(--kd-nav-overlay)_no-repeat] min-[1080px]:data-transparent:border-b-transparent"
  data-overlay={overlay ? "" : undefined}
  data-transparent={overlay ? "" : undefined}
>
  <div
    class="max-w-kd mx-auto px-24 sm:px-48 h-88 flex items-center justify-between gap-40"
  >
    <a href="/" class="block shrink-0" aria-label={nav.logoAlt}>
      {/* Vector (public/kd-logo.svg, scripts/trace-logo.py): the raster
          was cut to 102px and pixelated on high-density screens. */}
      <img
        src="/kd-logo.svg"
        alt={nav.logoAlt}
        width="102"
        height="68"
        class="w-102 h-68 object-contain object-left"
      />
    </a>

    <nav
      class="hidden min-[1080px]:flex items-center gap-32 min-[1200px]:gap-40"
      aria-label="Primary"
    >
      <ul class="flex items-center gap-24 min-[1200px]:gap-32">
        {
          topLevel.map(({ link, i }) => {
            const kids = childrenOf(link.href);
            const active =
              isHere(link.href) || kids.some(({ link: k }) => isHere(k.href));
            return (
              <li class="relative group">
                <a
                  href={link.href}
                  aria-current={here === link.href ? "page" : undefined}
                  class:list={[
                    "flex items-center gap-6 text-nav pb-6 border-b",
                    active
                      ? "text-kd-mint border-b-kd-mint"
                      : "text-kd-mist border-b-transparent",
                  ]}
                >
                  <span data-edit={`${page}.nav.links.${i}.label`}>{link.label}</span>
                  {kids.length > 0 && (
                    <svg
                      class="w-10 h-10 transition-transform group-hover:rotate-180 group-focus-within:rotate-180"
                      viewBox="0 0 10 10"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path d="M1.5 3.5L5 7l3.5-3.5" stroke-linecap="square" />
                    </svg>
                  )}
                </a>
                {/* pt-31 bridges the gap from the link to the header's
                    bottom edge, so the pointer never leaves the group on
                    its way down and the menu hangs from the bar. */}
                {kids.length > 0 && (
                  <div class="absolute left-0 top-full pt-31 hidden group-hover:block group-focus-within:block">
                    {/* kd-nav-menu: frosted over the hero, see global.css. */}
                    <ul class="kd-nav-menu min-w-200 bg-kd-ink border border-kd-nav-border py-8">
                      {kids.map(({ link: kid, i: j }) => (
                        <li>
                          <a
                            href={kid.href}
                            aria-current={here === kid.href ? "page" : undefined}
                            class:list={[
                              "block text-nav px-20 py-10 whitespace-nowrap hover:text-kd-mint",
                              isHere(kid.href) ? "text-kd-mint" : "text-kd-mist",
                            ]}
                          >
                            <span data-edit={`${page}.nav.links.${j}.label`}>{kid.label}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>

      <a
        href={nav.cta.href}
        class="inline-flex items-center whitespace-nowrap text-ui bg-kd-mint text-kd-ink-deep px-24 py-12"
      >
        <span data-edit={`${page}.nav.cta.label`}>{nav.cta.label}</span>
      </a>
    </nav>

    <button
      type="button"
      id="nav-drawer-toggle"
      class="min-[1080px]:hidden inline-flex items-center justify-center w-40 h-40 -mr-8 text-kd-mist shrink-0"
      aria-expanded="false"
      aria-controls="nav-drawer"
      aria-label="Open menu"
    >
      <svg
        id="nav-drawer-icon-open"
        class="w-24 h-24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="square" />
      </svg>
      <svg
        id="nav-drawer-icon-close"
        class="hidden w-24 h-24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M5 5l14 14M19 5L5 19" stroke-linecap="square" />
      </svg>
    </button>
  </div>

  {/* The drawer renders the same `nav.links` / `nav.cta` values as the
      bar above — not a second field, the same one twice. The bar's
      spans carry the real data-edit key; check-edit-keys.mjs requires
      every key to be unique on the page, so this copy is marked
      data-no-edit rather than given a second key that would drift from
      the one definition in home.ts. Same treatment as the footer's
      generated year in SiteFooter.astro. */}
  <nav
    id="nav-drawer"
    class="hidden min-[1080px]:hidden border-t border-t-kd-nav-border bg-kd-ink"
    aria-label="Primary, mobile"
  >
    <ul class="flex flex-col px-24 py-24 gap-24">
      {
        topLevel.map(({ link }) => {
          const kids = childrenOf(link.href);
          const active = isHere(link.href);
          return (
            <li>
              <a
                href={link.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "inline-block text-nav pb-6 border-b",
                  active
                    ? "text-kd-mint border-b-kd-mint"
                    : "text-kd-mist border-b-transparent",
                ]}
              >
                <span data-no-edit>{link.label}</span>
              </a>
              {kids.length > 0 && (
                <ul class="flex flex-col gap-16 mt-16 pl-16 border-l border-l-kd-nav-border">
                  {kids.map(({ link: kid }) => (
                    <li>
                      <a
                        href={kid.href}
                        aria-current={here === kid.href ? "page" : undefined}
                        class:list={[
                          "inline-block text-nav pb-6 border-b",
                          isHere(kid.href)
                            ? "text-kd-mint border-b-kd-mint"
                            : "text-kd-mist border-b-transparent",
                        ]}
                      >
                        <span data-no-edit>{kid.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })
      }
    </ul>
    <div class="px-24 pb-24">
      <a
        href={nav.cta.href}
        class="flex items-center justify-center text-ui bg-kd-mint text-kd-ink-deep px-24 py-12"
      >
        <span data-no-edit>{nav.cta.label}</span>
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-drawer-toggle");
  const drawer = document.getElementById("nav-drawer");
  const iconOpen = document.getElementById("nav-drawer-icon-open");
  const iconClose = document.getElementById("nav-drawer-icon-close");

  const setOpen = (open: boolean) => {
    drawer?.classList.toggle("hidden", !open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  };

  toggle?.addEventListener("click", () => {
    setOpen(drawer?.classList.contains("hidden") ?? false);
  });

  drawer?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setOpen(false);
  });

  const header = document.querySelector<HTMLElement>("header[data-overlay]");
  const hero = document.querySelector("[data-nav-overlay]");
  if (header && hero) {
    const update = () =>
      header.toggleAttribute(
        "data-transparent",
        hero.getBoundingClientRect().bottom > header.offsetHeight,
      );
    update();
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update);
  }
</script>
