---
/* ============================================================
   Fixed site nav — 88px, ink, 1px bottom border
   ------------------------------------------------------------
   Fixed, so the first band of every page has to clear it. The hero does
   that with pt-144. See DESIGN-SYSTEM.md §7.

   The active link is mint with a 1px mint bottom border. That border is
   the only underline in the design — never text-decoration.
   ============================================================ */
import { Image } from "astro:assets";
import logo from "../assets/kd-logo-white.png";
import { home } from "../data/home";

const { nav } = home;
const here = Astro.url.pathname.replace(/(.)\/+$/, "$1");
---

<header
  class="fixed top-0 inset-x-0 z-50 h-88 bg-kd-ink border-b border-b-kd-nav-border"
>
  <nav
    class="max-w-kd mx-auto px-48 h-full flex items-center justify-between gap-40"
    aria-label="Primary"
  >
    <a href="/" class="block shrink-0" aria-label={nav.logoAlt}>
      <Image
        src={logo}
        alt={nav.logoAlt}
        width={102}
        height={68}
        loading="eager"
        class="w-102 h-68 object-contain object-left"
      />
    </a>

    <div class="flex items-center gap-40">
      <ul class="flex items-center gap-40">
        {
          nav.links.map((link, i) => {
            const active = here === link.href;
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "block text-nav pb-6 border-b",
                    active
                      ? "text-kd-mint border-b-kd-mint"
                      : "text-kd-mist border-b-transparent",
                  ]}
                >
                  <span data-edit={`home.nav.links.${i}.label`}>{link.label}</span>
                </a>
              </li>
            );
          })
        }
      </ul>

      <a
        href={nav.cta.href}
        class="inline-flex items-center text-ui bg-kd-mint text-kd-ink-deep px-24 py-12"
      >
        <span data-edit="home.nav.cta.label">{nav.cta.label}</span>
      </a>
    </div>
  </nav>
</header>
