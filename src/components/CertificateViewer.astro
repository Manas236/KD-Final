---
/* ============================================================
   CertificateViewer — the "View certificate" dialog
   ------------------------------------------------------------
   21 Oct 2026, at Sir's request (OPEN-QUESTIONS.md #58). A card in /hse's
   Certifications whose certificate image exists has a "View certificate"
   button (InfoSections.astro), and so has each "Certified to" line in
   the footer, on every page (SiteFooter.astro); this is the one dialog
   they all open. The footer draws it, once per page, while any
   certificate image exists. A button carries the image's URL
   (data-cert-open) and its layout (data-cert-layout); the dialog's
   title is the text of the [data-cert-name] element in the button's
   <li>, read when it opens.

   A DETERRENT, NOT PROTECTION. A web page cannot stop an operating
   system's snipping tool, a phone's screenshot or a camera, and anyone
   who reads this script can rebuild the image. What protects the
   certificate is the watermark burned into the image itself
   (scripts/build-certificates.mjs: "K.D. Constructions · For
   verification only", tiled across it). This only makes casual copying
   awkward:

     · the image is drawn onto a <canvas> from an Image object that is
       never in the page, so there is no <img> to save and no download
       link;
     · the file itself is a mosaic: scripts/build-certificates.mjs cuts
       it into tiles and shuffles them, and only this script puts them
       back (the same seeded shuffle, its functions below), so the JPEG
       opened on its own, or saved from the network panel, shows nothing
       usable;
     · right-click, dragging and text selection do nothing inside it, and
       Ctrl/Cmd + S and Ctrl/Cmd + P are swallowed while it is open;
     · the moment the Windows or Command key goes down, or Ctrl + Shift
       together, the canvas goes blank: that is how Win + Shift + S,
       Win + PrintScreen and the Mac's Cmd + Shift + 3/4/5 all begin,
       and the page hears it before the capture is taken. It stays blank
       until the keys are up AND the pointer moves on the page again (or
       a tap, or another key), so a capture whose keys are let go before
       the area is chosen (Cmd + Shift + 4) still finds it blank;
     · PrintScreen on its own blanks it the same way and, where the
       browser allows it, overwrites the clipboard. Windows reports that
       key only once it is released, after the capture, so for a
       full-screen capture this is late; the clipboard is what it saves;
     · while the window has lost focus, the tab is hidden or the mouse
       has left the window (towards a capture tool on the taskbar or the
       dock), the certificate is drawn blurred, and sharp again on
       return;
     · every drawing of it, sharp or blurred, carries a VIEWING STAMP
       (24 Oct 2026): "Viewed on kdconstructions.net · 24 Oct 2026", the
       date the visitor's own when the viewer opens, the words
       `certificateViewer.stamp` in src/data/home.ts. A phone's
       screenshot cannot be blocked, nor even noticed, by a web page, so
       on a phone the watermark in the file was all a capture carried;
       now every capture, on any device, is plainly a dated copy taken
       from the website. It is tiled at -30 degrees, rows and columns,
       over the whole certificate, in the gaps between the watermark's
       rows, and drawn into the canvas in the same pixels as the
       certificate, so no capture of the certificate is without it and
       nothing bigger than a word or two can be cropped clear of it. Not
       drawn while the canvas is blank;
     · in print, the dialog and the buttons are hidden (global.css).

   The page around it behaves as ever; nothing here runs until a button
   is pressed, except the print rule.

   ACCESSIBLE. A modal <dialog> (the rest of the page inert behind it),
   titled by the card's own title, the canvas an image named the same.
   Focus goes to Close and stays in the dialog (Tab keeps it there); Esc
   or Close shuts it and focus returns to the button that opened it. On a
   phone it fills the screen and the certificate is fitted to it.

   EDIT MODE. The labels are `data-no-edit` (copy in src/data/home.ts,
   `certificateViewer`; the stamp is an attribute, never text on the
   page), so Close always closes; Esc inside the viewer is kept from
   the editor, for which Esc with nothing open means "leave edit mode".
   The cards' own text edits as on any card.

   Surfaces and type are the nav's: ink-deep, an 88px bar with a hairline,
   a `d8` title, the ghost button on dark (DESIGN-SYSTEM §6).
   ============================================================ */
interface Props {
  labels: { readonly view: string; readonly close: string; readonly stamp: string };
}

const { labels } = Astro.props;
---

<dialog
  class="fixed inset-0 m-0 p-0 w-full h-full max-w-none max-h-none border-0 bg-kd-ink-deep text-kd-mist select-none [-webkit-touch-callout:none] open:flex flex-col"
  data-cert-viewer
  data-cert-stamp={labels.stamp}
  aria-labelledby="kd-cert-title"
>
  <div
    class="w-full max-w-kd mx-auto px-24 sm:px-48 h-88 shrink-0 flex items-center justify-between gap-24 border-b border-b-kd-nav-border"
  >
    <h2 id="kd-cert-title" class="font-display text-d8 text-kd-mist truncate" data-cert-title></h2>
    <button
      type="button"
      class="shrink-0 inline-flex items-center text-ui text-kd-mist border border-kd-ghost-outline px-24 py-12 hover:text-kd-mint hover:border-kd-mint focus-visible:text-kd-mint focus-visible:border-kd-mint"
      data-cert-close
    >
      <span data-no-edit>{labels.close}</span>
    </button>
  </div>
  <div class="flex-1 min-h-0 flex items-center justify-center p-16 sm:p-24" data-cert-stage>
    <canvas class="block" role="img" data-cert-canvas></canvas>
  </div>
</dialog>

<script>
  /* See the header of this file: a deterrent, and nothing more. */

  /* The tile shuffle: the same functions as in
     scripts/build-certificates.mjs. Change one, change both. */
  function random(seed: number) {
    // mulberry32
    let a = seed >>> 0;
    return () => {
      a = (a + 0x6d2b79f5) >>> 0;
      let t = a;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  /** Tile i of the file is tile order[i] of the certificate. */
  function tileOrder(count: number, seed: number) {
    const order = Array.from({ length: count }, (_, i) => i);
    const next = random(seed);
    for (let i = count - 1; i > 0; i--) {
      const j = Math.floor(next() * (i + 1));
      [order[i], order[j]] = [order[j], order[i]];
    }
    return order;
  }

  /** The certificate put back together, at the size it was written. */
  function assemble(file: HTMLImageElement, layout: string) {
    const [width, height, tile, seed] = layout.split(" ").map(Number);
    if (!width || !height || !tile) return null;
    const cols = Math.ceil(width / tile);
    const rows = Math.ceil(height / tile);
    const sheet = document.createElement("canvas");
    sheet.width = width;
    sheet.height = height;
    const c = sheet.getContext("2d");
    if (!c) return null;
    tileOrder(cols * rows, seed).forEach((from, to) => {
      c.drawImage(
        file,
        (to % cols) * tile,
        Math.floor(to / cols) * tile,
        tile,
        tile,
        (from % cols) * tile,
        Math.floor(from / cols) * tile,
        tile,
        tile,
      );
    });
    return sheet;
  }

  const dialog = document.querySelector<HTMLDialogElement>("dialog[data-cert-viewer]");
  const canvas = dialog?.querySelector<HTMLCanvasElement>("canvas[data-cert-canvas]");
  const ctx = canvas?.getContext("2d");
  const stage = dialog?.querySelector<HTMLElement>("[data-cert-stage]");
  const heading = dialog?.querySelector<HTMLElement>("[data-cert-title]");
  const closeButton = dialog?.querySelector<HTMLButtonElement>("[data-cert-close]");

  if (dialog && canvas && ctx && stage && heading && closeButton) {
    /* The certificate as put back together, while the viewer is open. */
    let sheet: HTMLCanvasElement | null = null;
    let opener: HTMLElement | null = null;
    /* Which opening a loading image belongs to. */
    let opening = 0;
    /* Drawn blurred while the window is not in front or the mouse is
       out of it. */
    let veiled = false;
    let pointerOut = false;
    /* Drawn blank from a capture shortcut until the keys are up
       (`waiting`) and then the person is back on the page. */
    let blanked = false;
    let waiting = false;
    /* The viewing stamp of this opening: the label, with the date. */
    let stamp = "";
    let fontAsked = false;
    const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    const STAMP_OPACITY = 0.18;
    /* A stamp row in every gap between watermark rows (1), or every
       second gap (2). */
    const STAMP_EVERY = 1;

    /* The viewing stamp (see the header) over the certificate drawn at
       w x h from the file's w0 x h0, in the canvas's CSS pixels. Its rows
       run midway between the rows of the watermark burned into the file,
       so neither covers the other: the watermark's size, step, span and
       turn are those of watermarkSvg() in scripts/build-certificates.mjs.
       If that changes, change this. Each row has one whole stamp centred on
       the stretch of it that crosses the certificate, and more copies
       either side out to its edges. */
    const mark = (w: number, h: number, w0: number, h0: number) => {
      if (!stamp) return;
      // A 26th of the drawn width; of the height on a landscape certificate.
      const size = Math.max(11, Math.min(w, h) / 26);
      const font = `600 ${size}px ${getComputedStyle(dialog).fontFamily}`;
      if (!fontAsked && !document.fonts.check(font, stamp)) {
        // Drawn again once the face is in.
        fontAsked = true;
        document.fonts.load(font, stamp).then(draw, () => {});
      }
      const k = w / w0;
      const wmSize = Math.round(Math.max(w0, h0) / 44);
      const wmStep = Math.round(wmSize * 4.2);
      const span = Math.ceil(Math.hypot(w0, h0));
      const cos = Math.cos(Math.PI / 6);
      const sin = Math.sin(Math.PI / 6);
      ctx.save();
      ctx.font = font;
      ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue("--kd-ink").trim();
      ctx.globalAlpha = STAMP_OPACITY;
      const box = ctx.measureText(stamp);
      // From the middle of a gap to the baseline that centres the words.
      const lift = (box.actualBoundingBoxAscent - box.actualBoundingBoxDescent) / 2;
      const period = box.width + size * 3;
      // Turned about the centre, as the watermark is.
      ctx.translate(w / 2, h / 2);
      ctx.rotate(-Math.PI / 6);
      ctx.translate(-w / 2, -h / 2);
      for (let y = -span; y < span * 2; y += wmStep * STAMP_EVERY) {
        const middle = (y + (wmStep - wmSize / 2) / 2) * k;
        // Where this row crosses the certificate, along the row, from the centre.
        const d = middle - h / 2;
        const from = Math.max((-w / 2 - d * sin) / cos, (d * cos - h / 2) / sin);
        const to = Math.min((w / 2 - d * sin) / cos, (d * cos + h / 2) / sin);
        if (from >= to) continue;
        const centred = w / 2 + (from + to) / 2 - box.width / 2;
        let x = centred - Math.ceil((centred - (w / 2 + from)) / period) * period;
        for (; x < w / 2 + to; x += period) ctx.fillText(stamp, x, middle + lift);
      }
      ctx.restore();
    };

    /* The certificate, fitted inside the stage, sharp on a dense screen. */
    const draw = () => {
      const w0 = sheet?.width ?? 0;
      const h0 = sheet?.height ?? 0;
      if (!sheet || !w0 || !h0 || !dialog.open) return;
      const style = getComputedStyle(stage);
      const roomW = stage.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
      const roomH = stage.clientHeight - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom);
      const scale = Math.min(roomW / w0, roomH / h0, 1);
      const w = Math.max(1, Math.floor(w0 * scale));
      const h = Math.max(1, Math.floor(h0 * scale));
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      if (blanked) return;
      if (veiled) {
        // A browser without canvas filters draws nothing while veiled.
        if (!("filter" in ctx)) return;
        ctx.filter = "blur(24px)";
        ctx.drawImage(sheet, 0, 0, w, h);
        ctx.filter = "none";
      } else {
        ctx.drawImage(sheet, 0, 0, w, h);
      }
      // Sharp over the blurred certificate too.
      mark(w, h, w0, h0);
    };

    const open = (button: HTMLElement) => {
      const src = button.getAttribute("data-cert-open");
      const layout = button.getAttribute("data-cert-layout");
      if (!src || !layout) return;
      opener = button;
      const title =
        button.closest("li")?.querySelector("[data-cert-name]")?.textContent?.replace(/\s+/g, " ").trim() ?? "";
      heading.textContent = title;
      canvas.setAttribute("aria-label", title);
      veiled = document.hidden || !document.hasFocus() || pointerOut;
      blanked = false;
      waiting = false;
      const today = new Date();
      stamp = (dialog.getAttribute("data-cert-stamp") ?? "").replace(
        "{date}",
        `${today.getDate()} ${MONTHS[today.getMonth()]} ${today.getFullYear()}`,
      );
      sheet = null;
      const mine = ++opening;
      const file = new Image();
      file.decoding = "async";
      file.addEventListener("load", () => {
        if (mine !== opening || !dialog.open) return;
        sheet = assemble(file, layout);
        draw();
      });
      file.src = src;
      dialog.showModal();
      closeButton.focus();
    };

    const shut = () => {
      if (dialog.open) dialog.close();
    };

    /* Every way out ends here, Esc included: the drawing goes, and focus
       goes back to the button that opened it. */
    dialog.addEventListener("close", () => {
      opening++;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      sheet = null;
      heading.textContent = "";
      opener?.focus();
      opener = null;
    });

    document.addEventListener("click", (event) => {
      const button = (event.target as Element).closest?.<HTMLElement>("[data-cert-open]");
      if (button) open(button);
    });
    closeButton.addEventListener("click", shut);

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        // Close here, and keep the key from the editor (edit mode).
        event.preventDefault();
        event.stopPropagation();
        shut();
      } else if (event.key === "Tab") {
        // Close is the one control: focus stays on it.
        event.preventDefault();
        closeButton.focus();
      }
    });

    /* Save and Print, while the viewer is open. */
    document.addEventListener(
      "keydown",
      (event) => {
        if (!dialog.open) return;
        const key = event.key.toLowerCase();
        if ((event.ctrlKey || event.metaKey) && (key === "s" || key === "p")) {
          event.preventDefault();
          event.stopPropagation();
        }
      },
      true,
    );

    /* ---------- capture shortcuts ---------- */
    const blank = () => {
      blanked = true;
      waiting = false;
      draw();
    };
    /* The keys are up: still blank until the person is back on the page. */
    const release = () => {
      if (blanked) waiting = true;
    };
    const back = () => {
      if (!waiting) return;
      waiting = false;
      blanked = false;
      draw();
    };
    /* Win / Cmd, or Ctrl + Shift: how a system or browser capture starts. */
    const capturing = (event: KeyboardEvent) =>
      event.key === "Meta" || event.key === "OS" || event.metaKey || (event.ctrlKey && event.shiftKey);

    document.addEventListener(
      "keydown",
      (event) => {
        if (!dialog.open) return;
        if (capturing(event)) blank();
        else if (!["Shift", "Control", "Alt", "PrintScreen"].includes(event.key)) back();
      },
      true,
    );
    document.addEventListener(
      "keyup",
      (event) => {
        if (!dialog.open) return;
        if (event.key === "PrintScreen") {
          // Windows reports this key only on release, after the capture.
          blank();
          navigator.clipboard?.writeText("").catch(() => {});
          release();
          return;
        }
        if (!(event.metaKey || (event.ctrlKey && event.shiftKey))) release();
      },
      true,
    );
    document.addEventListener("pointermove", back);
    document.addEventListener("pointerdown", back);

    for (const type of ["contextmenu", "dragstart", "selectstart", "copy"]) {
      dialog.addEventListener(type, (event) => event.preventDefault());
    }

    /* ---------- away and back ---------- */
    const reveal = () => {
      const away = document.hidden || !document.hasFocus() || pointerOut;
      if (!dialog.open || veiled === away) return;
      veiled = away;
      draw();
    };
    window.addEventListener("blur", reveal);
    window.addEventListener("focus", () => {
      // Back from the Start menu or a capture tool: the key that took
      // focus away may never be reported released here.
      release();
      reveal();
    });
    document.addEventListener("visibilitychange", reveal);
    /* The mouse out of the window (no related target), and back in. */
    document.addEventListener("pointerout", (event) => {
      if (event.pointerType !== "mouse" || event.relatedTarget) return;
      pointerOut = true;
      reveal();
    });
    document.addEventListener("pointerover", (event) => {
      if (event.pointerType !== "mouse" || !pointerOut) return;
      pointerOut = false;
      reveal();
    });
    window.addEventListener("resize", draw);
  }
</script>
