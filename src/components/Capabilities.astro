---
/* ============================================================
   Capabilities — white band, four numbered cards
   ------------------------------------------------------------
   A 4-column grid with NO GAP. The dividers between cards are the
   cards' own 1px right borders, and cards 1–3 carry one while the last
   does not. A gap here would put daylight on both sides of every line
   and the row would stop reading as one ruled block.

   Each card: 2px ink top border, 32px padding, and then numeral →
   title → body → a 32×1px mint rule at the foot. See DESIGN-SYSTEM.md
   §4.2 for what this card is FOR — an enumerated set where the order
   means something. It is not interchangeable with the differentiator
   card, which looks similar and says something different.

   The mint rule and the mint numeral both use `--kd-mint-2` here, not
   `--kd-mint` — pure mint on white is ~1.2:1. See OPEN-QUESTIONS.md #1.

   MOBILE: 4-up → 2-up at `lg` (1024) → 1-up at `sm` (640), per
   DESIGN-SYSTEM.md §10. The right border is a column divider — the
   divider trap — so its meaning changes at each step: at 4-up it marks
   cards 1–3; at 2-up it marks the LEFT card of each row (0 and 2); at
   1-up it disappears entirely and a bottom border on every card but the
   last takes over. The 2-up step also needs a bottom border under the
   first row (cards 0–1), since stacking now happens there too. The top
   border is unchanged at every width — it is part of the card, not a
   divider.
   ============================================================ */
import { home } from "../data/home";
import Kicker from "./Kicker.astro";

const { capabilities } = home;
---

<section class="bg-white py-96">
  <div class="max-w-kd mx-auto px-24 sm:px-48">
    <Kicker
      label={capabilities.kicker}
      editKey="home.capabilities.kicker"
      tone="light"
    />

    <h2
      class="font-display text-d4 text-kd-ink mt-16"
      data-edit="home.capabilities.heading"
    >
      {capabilities.heading}
    </h2>

    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 mt-56">
      {
        capabilities.cards.map((card, i) => {
          const last = capabilities.cards.length - 1;
          return (
            <li
              class:list={[
                "flex flex-col border-t-2 border-t-kd-ink p-32",
                i < last && "lg:border-r lg:border-r-kd-card-border-light",
                (i === 0 || i === 2) &&
                  i < last &&
                  "sm:max-lg:border-r sm:max-lg:border-r-kd-card-border-light",
                i < 2 &&
                  "sm:max-lg:border-b sm:max-lg:border-b-kd-card-border-light",
                i < last &&
                  "max-sm:border-b max-sm:border-b-kd-card-border-light",
              ]}
            >
              <span
                class="text-num text-kd-mint-2"
                data-edit={`home.capabilities.cards.${i}.num`}
              >
                {card.num}
              </span>
              <h3
                class="font-display text-d8 text-kd-ink mt-16"
                data-edit={`home.capabilities.cards.${i}.title`}
              >
                {card.title}
              </h3>
              <p
                class="text-body-sm text-kd-slate-2 mt-12"
                data-edit={`home.capabilities.cards.${i}.body`}
              >
                {card.body}
              </p>
              {/* At the FOOT of the card, not 32px under whatever the body
                  happens to end at. Card 4's copy runs to four lines where
                  1-3 run to three, so a plain margin left its rule sitting
                  22px below the others and the row read as ragged. mt-auto
                  inside the flex column bottom-aligns all four; the pt-32
                  keeps the design's 32px of clearance as a minimum. */}
              <span class="block mt-auto pt-32">
                <span class="block w-32 h-1 bg-kd-mint-2" aria-hidden="true" />
              </span>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
