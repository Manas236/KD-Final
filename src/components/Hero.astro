---
/* ============================================================
   Hero — ink band, full-bleed image, 568px text column
   ------------------------------------------------------------
   MOBILE, per DESIGN-SYSTEM.md §10: the H1 steps down through the
   existing display scale rather than inventing a size — `d1` (72px) at
   `lg` and up, `d3` (48px) from `sm`, `d4` (36px) below that. The stat
   grid stays 2×2 from `sm` up and only goes to a single column below
   640 — it never goes to four across.

   THE EXPORT LIED ABOUT TWO THINGS HERE and both are ignored:

     · the stats came through as a vertical flex column. They are a 2×2
       grid, 16px gap, INSIDE the 568px text column — not full width.
     · the image and its overlay came through absolutely positioned at
       pixel offsets. They are a stacked backdrop behind normal flow.

   The backdrop is four layers, bottom to top: the still at
   --kd-hero-image-opacity, the drone video at the same opacity, the 90°
   ink gradient over both, then the content. The gradient is near-opaque
   ink across the left 45%, which is exactly where the text sits — so
   the picture is chosen for what is in its centre and RIGHT half.

   THE VIDEO is a loop cut from the client's drone footage of Uran
   Railway Station by scripts/build-hero-video.mjs, which also writes the
   still (hero-uran-poster.jpg, the video's own first frame). The HTML
   carries no video source and nothing autoplays: the script at the foot
   of this file loads and plays it once the page has loaded, and only at
   1080px and up (phones keep the still unless HERO_VIDEO_ON_PHONES is
   switched on, and then get the 720p file), and never with reduced
   motion, Save-Data, edit mode or without `kd-motion`. It is invisible
   until it is actually playing,
   then fades in over the still (motion.css §5), and pauses while the
   hero is off screen or the tab is hidden. If it cannot play, the
   still simply stays. Neither layer is in the flow, so the layout is
   the same whichever shows.

   DESKTOP (≥1080px) IS DIFFERENT, by client request: the still and the
   video run at full strength under `--kd-hero-overlay-photo`, the stat tiles
   sit on ink, and the nav is transparent over it (Nav.astro, `overlay`).
   Below 1080 the description above holds unchanged. `data-nav-overlay`
   is what the nav watches to know when to go solid again.

   ON LOAD the headline, the sub-paragraph and the buttons fade up once,
   in that order: `data-hero-in`, motion.css §4. The still is never
   held back. The fade starts at 35%, not zero, because the headline (the
   sub-paragraph on a phone) is the page's Largest Contentful Paint, and
   text at zero opacity does not count as painted: see motion.css.
   ============================================================ */
import { Image } from "astro:assets";
import backdrop from "../assets/hero-uran-poster.jpg";
import { home } from "../data/home";
import Arrow from "./Arrow.astro";
import Kicker from "./Kicker.astro";

const { hero } = home;
---

<section class="relative bg-kd-ink overflow-hidden" data-nav-overlay>
  <div class="absolute inset-0" aria-hidden="true">
    <Image
      src={backdrop}
      alt={hero.backdropAlt}
      width={1551}
      height={872}
      loading="eager"
      fetchpriority="high"
      class="w-full h-full object-cover object-center [opacity:var(--kd-hero-image-opacity)] min-[1080px]:[opacity:1]"
    />
    <video
      class="absolute inset-0 w-full h-full object-cover object-center [opacity:var(--kd-hero-image-opacity)] min-[1080px]:[opacity:1]"
      data-hero-video
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      disableremoteplayback
    >
    </video>
    <div
      class="absolute inset-0 [background-image:var(--kd-hero-overlay)] min-[1080px]:[background-image:var(--kd-hero-overlay-photo)]"
    >
    </div>
  </div>

  <div class="relative max-w-kd mx-auto px-24 sm:px-48 pt-144 pb-80">
    <div class="w-568 max-w-full">
      <Kicker label={hero.kicker} editKey="home.hero.kicker" />

      {/* THE SPACE BETWEEN THESE TWO SPANS IS A WORD GAP, not formatting.
          The halves are stored without a joining space, because the
          editor trims every value it reads off the page and a trailing
          space inside a slot would not survive its first edit. So the
          gap has to live in the markup.

          It only survives because `compressHTML` is off in
          astro.config.mjs — with Astro's compressor on, inter-tag
          whitespace is removed and even an explicit {" "} expression is
          swallowed, giving "Infrastructure,Brick by Brick." The {" "}
          below is kept as a marker that the whitespace is deliberate;
          the config is what makes it work. Turn the compressor back on
          and this heading breaks. */}
      <h1 class="font-display text-d4 sm:text-d3 lg:text-d1 text-kd-mist mt-16" data-hero-in="1">
        <span data-edit="home.hero.headline.lead">{hero.headline.lead}</span>{" "}
        <span class="text-kd-mint" data-edit="home.hero.headline.accent"
          >{hero.headline.accent}</span
        >
      </h1>

      <p class="text-body-lg text-kd-mist mt-24" data-edit="home.hero.sub" data-hero-in="2">
        {hero.sub}
      </p>

      <div class="flex flex-wrap items-center gap-16 mt-32" data-hero-in="3">
        <a
          href={hero.buttons.primary.href}
          class="inline-flex items-center gap-8 text-ui bg-kd-mint text-kd-ink-deep px-24 py-12"
        >
          <span data-edit="home.hero.buttons.primary.label"
            >{hero.buttons.primary.label}</span
          >
          <Arrow />
        </a>
        <a
          href={hero.buttons.secondary.href}
          class="inline-flex items-center text-ui text-kd-mist border border-kd-ghost-outline px-24 py-12 hover:text-kd-mint hover:border-kd-mint focus-visible:text-kd-mint focus-visible:border-kd-mint"
        >
          <span data-edit="home.hero.buttons.secondary.label"
            >{hero.buttons.secondary.label}</span
          >
        </a>
      </div>

      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-16 mt-56">
        {
          hero.stats.map((stat, i) => (
            <div class="bg-kd-stat-fill min-[1080px]:[background-color:var(--kd-hero-stat-fill-photo)] border border-kd-stat-border p-24">
              <dd
                class="font-display text-d5 text-kd-mint"
                data-edit={`home.hero.stats.${i}.value`}
              >
                {stat.value}
              </dd>
              <dt
                class="text-label uppercase text-kd-slate mt-8"
                data-edit={`home.hero.stats.${i}.label`}
              >
                {stat.label}
              </dt>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<script>
  /* The drone video behind the hero: see the note at the top of this file. */

  /* Phones keep the still. Set this to true to give them the 720p file. */
  const HERO_VIDEO_ON_PHONES = false;
  const SOURCE = { desktop: "/video/hero-uran-1080.mp4", phone: "/video/hero-uran-720.mp4" };

  const root = document.documentElement;
  const video = document.querySelector<HTMLVideoElement>("video[data-hero-video]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  const desktop = matchMedia("(min-width: 1080px)");

  /* Every condition, checked each time the video would start. */
  const allowed = () =>
    root.classList.contains("kd-motion") &&
    !root.hasAttribute("data-nt-mode") &&
    !reduce.matches &&
    !(navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData &&
    (desktop.matches || HERO_VIDEO_ON_PHONES);

  if (video) {
    /* `running`: a source is set and play() has succeeded. `failed`: the
       browser refused to play, so the still stays for this visit. */
    let running = false;
    let failed = false;
    let inView = true;

    const state = (value: string) => video.setAttribute("data-hero-video", value);

    /* Back to the still: no source, nothing loaded, nothing drawn. */
    const stop = () => {
      running = false;
      video.pause();
      video.removeAttribute("src");
      video.load();
      state("");
    };

    /* Hidden ("wait") until it is actually playing, then "on" fades it
       in over the still (motion.css §5). */
    const start = () => {
      state("wait");
      video.muted = true;
      video.src = desktop.matches ? SOURCE.desktop : SOURCE.phone;
      video.play().then(
        () => {
          running = true;
          sync();
        },
        () => {
          if (video.getAttribute("data-hero-video") !== "wait") return;
          failed = true;
          stop();
        },
      );
    };

    /* Plays only while the hero is on screen and the tab is showing. */
    const sync = () => {
      if (!running) return;
      if (inView && !document.hidden) video.play().catch(() => {});
      else video.pause();
    };

    /* The editor switched on, or reduced motion asked for: the still.
       Switched back: the video again. */
    const recheck = () => {
      if (allowed()) {
        if (!running && !failed && video.getAttribute("data-hero-video") !== "wait") start();
      } else if (video.hasAttribute("src")) {
        stop();
      }
    };

    video.addEventListener("playing", () => {
      if (video.getAttribute("data-hero-video") === "wait") state("on");
    });
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      sync();
    }).observe(video.closest("section") ?? video);
    document.addEventListener("visibilitychange", sync);
    new MutationObserver(recheck).observe(root, { attributes: true, attributeFilter: ["data-nt-mode"] });
    reduce.addEventListener("change", recheck);

    /* Not before the page has loaded, so the video's download never
       competes with the fonts and the still for the first paint. */
    if (document.readyState === "complete") recheck();
    else addEventListener("load", recheck, { once: true });
  }
</script>
