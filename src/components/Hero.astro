---
/* ============================================================
   Hero — ink band, full-bleed image, 568px text column
   ------------------------------------------------------------
   MOBILE, per DESIGN-SYSTEM.md §10: the H1 steps down through the
   existing display scale rather than inventing a size — `d1` (72px) at
   `lg` and up, `d3` (48px) from `sm`, `d4` (36px) below that. The stat
   grid stays 2×2 from `sm` up and only goes to a single column below
   640 — it never goes to four across.

   THE EXPORT LIED ABOUT TWO THINGS HERE and both are ignored:

     · the stats came through as a vertical flex column. They are a 2×2
       grid, 16px gap, INSIDE the 568px text column — not full width.
     · the image and its overlay came through absolutely positioned at
       pixel offsets. They are a stacked backdrop behind normal flow.

   The backdrop is three layers, bottom to top: the photograph at 20%
   opacity, the 90° ink gradient over it, then the content. The gradient
   is opaque ink across the left 45%, which is exactly where the text
   sits — so the photograph is chosen for what is in its RIGHT half.

   DESKTOP (≥1080px) IS DIFFERENT, by client request: the photograph
   runs at full strength under `--kd-hero-overlay-photo`, the stat tiles
   sit on ink, and the nav is transparent over it (Nav.astro, `overlay`).
   Below 1080 the description above holds unchanged. `data-nav-overlay`
   is what the nav watches to know when to go solid again.
   ============================================================ */
import { Image } from "astro:assets";
import backdrop from "../assets/hero-nhava-sheva-station.jpg";
import { home } from "../data/home";
import Arrow from "./Arrow.astro";
import Kicker from "./Kicker.astro";

const { hero } = home;
---

<section class="relative bg-kd-ink overflow-hidden" data-nav-overlay>
  <div class="absolute inset-0" aria-hidden="true">
    <Image
      src={backdrop}
      alt={hero.backdropAlt}
      width={1551}
      height={813}
      loading="eager"
      fetchpriority="high"
      class="w-full h-full object-cover object-center [opacity:var(--kd-hero-image-opacity)] min-[1080px]:[opacity:1]"
    />
    <div
      class="absolute inset-0 [background-image:var(--kd-hero-overlay)] min-[1080px]:[background-image:var(--kd-hero-overlay-photo)]"
    >
    </div>
  </div>

  <div class="relative max-w-kd mx-auto px-24 sm:px-48 pt-144 pb-80">
    <div class="w-568 max-w-full">
      <Kicker label={hero.kicker} editKey="home.hero.kicker" />

      {/* THE SPACE BETWEEN THESE TWO SPANS IS A WORD GAP, not formatting.
          The halves are stored without a joining space, because the
          editor trims every value it reads off the page and a trailing
          space inside a slot would not survive its first edit. So the
          gap has to live in the markup.

          It only survives because `compressHTML` is off in
          astro.config.mjs — with Astro's compressor on, inter-tag
          whitespace is removed and even an explicit {" "} expression is
          swallowed, giving "Infrastructure,Brick by Brick." The {" "}
          below is kept as a marker that the whitespace is deliberate;
          the config is what makes it work. Turn the compressor back on
          and this heading breaks. */}
      <h1 class="font-display text-d4 sm:text-d3 lg:text-d1 text-kd-mist mt-16">
        <span data-edit="home.hero.headline.lead">{hero.headline.lead}</span>{" "}
        <span class="text-kd-mint" data-edit="home.hero.headline.accent"
          >{hero.headline.accent}</span
        >
      </h1>

      <p class="text-body-lg text-kd-mist mt-24" data-edit="home.hero.sub">
        {hero.sub}
      </p>

      <div class="flex flex-wrap items-center gap-16 mt-32">
        <a
          href={hero.buttons.primary.href}
          class="inline-flex items-center gap-8 text-ui bg-kd-mint text-kd-ink-deep px-24 py-12"
        >
          <span data-edit="home.hero.buttons.primary.label"
            >{hero.buttons.primary.label}</span
          >
          <Arrow />
        </a>
        <a
          href={hero.buttons.secondary.href}
          class="inline-flex items-center text-ui text-kd-mist border border-kd-ghost-outline px-24 py-12"
        >
          <span data-edit="home.hero.buttons.secondary.label"
            >{hero.buttons.secondary.label}</span
          >
        </a>
      </div>

      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-16 mt-56">
        {
          hero.stats.map((stat, i) => (
            <div class="bg-kd-stat-fill min-[1080px]:[background-color:var(--kd-hero-stat-fill-photo)] border border-kd-stat-border p-24">
              <dd
                class="font-display text-d5 text-kd-mint"
                data-edit={`home.hero.stats.${i}.value`}
              >
                {stat.value}
              </dd>
              <dt
                class="text-label uppercase text-kd-slate mt-8"
                data-edit={`home.hero.stats.${i}.label`}
              >
                {stat.label}
              </dt>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
