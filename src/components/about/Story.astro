---
/* ============================================================
   Our Story — white band
   ------------------------------------------------------------
   Two 560px columns across the 1184px band (560 + 64 + 560), stacking
   below `lg`:

     left   kicker · H2 · lead (body, ink) · two body-sm paragraphs
     right  the ₹220 Cr figure on ink, then the four stats as a 2 × 2
            grid in the light-band "about stat" pattern

   This supersedes the literal single-column build of the export
   (OPEN-QUESTIONS.md #8 shape): the client's reference puts the figure
   and stats beside the story, top-aligned with the kicker.

   Two type calls, both logged in OPEN-QUESTIONS.md #15:

     · the H2 came through at 30/36, which is `d5`, the dark-band stat
       numeral. DESIGN-SYSTEM §8 gives the section-H2 role to `d4`, and
       the export's own other two H2s are `d4`, so this one is `d4`.
     · the four stat numerals came through at 20/28 (`d7`, the
       differentiator title). The "about stat" pattern is `d6` over
       `label-sm` — the pattern OPEN-QUESTIONS.md #5 named for exactly
       this band — so they are `d6`.
   ============================================================ */
import { about } from "../../data/about";
import Kicker from "../Kicker.astro";

const { story } = about;
---

<section class="bg-white py-96">
  <div
    class="max-w-kd mx-auto px-48 grid grid-cols-1 lg:grid-cols-2 gap-y-56 lg:gap-x-64 items-start"
  >
    <div class="max-w-560">
      <Kicker label={story.kicker} editKey="about.story.kicker" tone="light" />

      <h2 class="font-display text-d4 text-kd-ink mt-16" data-edit="about.story.heading">
        {story.heading}
      </h2>

      <p class="text-body text-kd-ink mt-32" data-edit="about.story.lead">
        {story.lead}
      </p>

      <p class="text-body-sm text-kd-slate-2 mt-20" data-edit="about.story.body1">
        {story.body1}
      </p>

      <p class="text-body-sm text-kd-slate-2 mt-20" data-edit="about.story.body2">
        {story.body2}
      </p>
    </div>

    <div class="max-w-560">
      {/* The one figure set on ink. */}
      <div class="bg-kd-ink p-32">
        <p class="font-display text-d3 text-kd-mint" data-edit="about.story.figure.value">
          {story.figure.value}
        </p>
        <p class="text-ui text-kd-mist mt-8" data-edit="about.story.figure.label">
          {story.figure.label}
        </p>
        <span class="block w-40 h-1 bg-kd-ghost-outline mt-16" aria-hidden="true"
        ></span>
        <p class="text-body-sm text-kd-fog mt-16" data-edit="about.story.figure.body">
          {story.figure.body}
        </p>
      </div>

      <dl class="mt-40 grid grid-cols-1 sm:grid-cols-2 gap-x-16">
        {
          story.stats.map((stat, i) => (
            <div class="border-t border-t-kd-divider-light pt-24 pb-20 flex flex-col-reverse justify-end">
              <dt
                class="text-label-sm text-kd-slate mt-6"
                data-edit={`about.story.stats.${i}.label`}
              >
                {stat.label}
              </dt>
              <dd
                class="font-display text-d6 text-kd-ink"
                data-edit={`about.story.stats.${i}.value`}
              >
                {stat.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
