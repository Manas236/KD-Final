---
/* ============================================================
   InfoSections — the card sections of an InfoPage
   ------------------------------------------------------------
   The stack of white / mist card sections that InfoPage.astro draws
   between its hero and its CTA, on its own so that /about can draw the
   same sections for the pages merged into it (21 Oct 2026,
   OPEN-QUESTIONS.md #58): Company, Capabilities, Resources, Clients and
   CSR, each under its own key prefix (`clients.sections.1.items.0.*`),
   exactly as on the page it was. The markup is InfoPage's, moved here
   unchanged; every note in InfoPage.astro's header about logo wells,
   pending cards, portraits and runtime cards is about what this file
   draws.

   Sections alternate white and mist starting on white, so the band
   after an ink one is always light and no two adjacent bands share a
   surface (DESIGN-SYSTEM §2).

   The default slot is a page's own band (/hse's site record) and comes
   after the last section, or right after the section whose `id` is
   `slotAfter` (/careers: the Apply Here form under Current openings,
   21 Oct 2026). Only where it is drawn moves; no key does.

   A `retired` card (the Indian Railways card on /clients, 21 Oct 2026)
   is not drawn, and every other card keeps its own index, so its keys do
   not move. The grid's shape follows the cards that are drawn.
   ============================================================ */
import { Image } from "astro:assets";
import Kicker from "./Kicker.astro";
import CertificateViewer from "./CertificateViewer.astro";
import type { InfoPageCopy, InfoSection } from "../data/pages";
import { certificateImage } from "../lib/certificates";
import { clientLogo, logoSize } from "../lib/client-logos";
import { portrait } from "../lib/portraits";

interface Props {
  /** First segment of every slot key. */
  page: string;
  sections: readonly InfoSection[];
  /** The `id` of the section the default slot follows. Without one, or
      with an id no section has, the slot follows the last section. */
  slotAfter?: string;
  /** The certificate viewer's labels (/hse). A card with a `cert` whose
      image exists gets a "View certificate" button, and the page one
      viewer (CertificateViewer.astro). No image, no button. */
  viewer?: InfoPageCopy["viewer"];
}

const { page, sections, slotAfter, viewer } = Astro.props;
const placed = !!slotAfter && sections.some((section) => section.id === slotAfter);
/* The cards each section draws: a retired one keeps its slot only. */
const shown = sections.map((section) => section.items.filter((item) => !item.retired));
const withLogos = shown.map((items) => items.some((item) => item.logo));
const withPortraits = shown.map((items) => items.some((item) => item.portrait));
const withCertificates = shown.some((items) => items.some((item) => certificateImage(item.cert)));
---

{
  sections.map((section, s) => (
    <Fragment>
    <section id={section.id} class:list={["py-96", s % 2 === 0 ? "bg-white" : "bg-kd-mist"]}>
      <div class="max-w-kd mx-auto px-24 sm:px-48">
        <Kicker
          label={section.kicker}
          editKey={`${page}.sections.${s}.kicker`}
          tone="light"
        />
        <h2
          class="font-display text-d4 text-kd-ink mt-16"
          data-edit={`${page}.sections.${s}.heading`}
        >
          {section.heading}
        </h2>
        {section.intro && (
          <p
            class="text-body text-kd-slate-2 mt-20 max-w-720"
            data-edit={`${page}.sections.${s}.intro`}
          >
            {section.intro}
          </p>
        )}

        <ul
          class:list={[
            "grid gap-24 mt-48 sm:grid-cols-2",
            // Two cards fill the band as halves, and four sit 2×2; at three columns
            // two leave the right third empty and the fourth is orphaned on its own row.
            // No half-empty last row: an odd last card at two columns spans both, and
            // a last row of two at three columns widens its final card to fill it.
            // Pure CSS, so it holds for the careers cards added at runtime too.
            withPortraits[s]
              ? "lg:grid-cols-4"
              : shown[s].length === 2 || shown[s].length === 4
              ? "sm:[&>li:last-child:nth-child(odd)]:col-span-2"
              : [
                  "lg:grid-cols-3",
                  "sm:max-lg:[&>li:last-child:nth-child(odd)]:col-span-2",
                  "lg:[&>li:last-child:nth-child(3n+2)]:col-span-2",
                  // A client section left with one card on its last row (seven
                  // railway clients) runs it across the row, logo centred.
                  withLogos[s] && "lg:[&>li:last-child:nth-child(3n+1)]:col-span-3",
                ],
          ]}
        >
          {section.items.map((item, i) => {
            if (item.retired) return null;
            const k = item.slot ? `${page}.${item.slot}` : `${page}.sections.${s}.items.${i}`;
            return (
            <li
              class:list={[
                "border border-kd-card-border-light border-t-2 border-t-kd-mint-2 p-32",
                item.pending && "border-dashed",
              ]}
              data-card="light framed"
              data-pending={item.pending ? "" : undefined}
              data-posting={item.posting}
              data-expires={item.expires}
            >
              {withLogos[s] && (
                <div class="-mx-32 -mt-32 mb-32 h-176 px-24 flex items-center justify-center border-b border-b-kd-card-border-light">
                  {item.logo ? (
                    <Image
                      src={clientLogo(item.logo)}
                      alt=""
                      {...logoSize(item.logo)}
                      densities={[1, 2]}
                      loading="lazy"
                      class="max-w-full object-contain"
                    />
                  ) : (
                    <span class="font-display text-d6 text-kd-ink" aria-hidden="true">
                      {item.title}
                    </span>
                  )}
                </div>
              )}
              {item.portrait && (
                <div class="-mx-32 -mt-32 mb-32 aspect-square overflow-hidden border-b border-b-kd-card-border-light bg-kd-mist">
                  <Image
                    src={portrait(item.portrait)}
                    alt={`Portrait of ${item.title}`}
                    width={400}
                    height={400}
                    densities={[1, 2]}
                    loading="lazy"
                    class="w-full h-full object-cover object-top"
                  />
                </div>
              )}
              {item.pending && (
                <span
                  class="inline-block text-badge uppercase text-kd-ink bg-kd-badge-fill border border-kd-badge-border px-8 py-6 mb-16"
                  data-edit={`${k}.pending`}
                >
                  {item.pending}
                </span>
              )}
              <h3
                class="font-display text-d8 text-kd-ink"
                data-edit={`${k}.title`}
              >
                {item.title}
              </h3>
              {item.role && (
                <p
                  class="text-label uppercase text-kd-mint-2 mt-6"
                  data-edit={`${k}.role`}
                >
                  {item.role}
                </p>
              )}
              {item.body && (
                <p
                  class="text-body-sm text-kd-slate-2 mt-12"
                  data-edit={`${k}.body`}
                >
                  {item.body}
                </p>
              )}
              {item.facts && (
                <dl class="flex flex-col gap-12 mt-16">
                  {item.facts.map((fact, f) => (
                    <div>
                      <dt
                        class="text-label uppercase text-kd-mint-2"
                        data-edit={`${k}.facts.${f}.label`}
                      >
                        {fact.label}
                      </dt>
                      <dd
                        class="text-body-sm text-kd-ink mt-6 break-words"
                        data-edit={`${k}.facts.${f}.value`}
                      >
                        {fact.value}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}
              {item.links && (
                <ul class="flex flex-col items-start gap-8 mt-16">
                  {item.links.map((link, l) => (
                    <li>
                      <a
                        href={link.href}
                        class="text-ui text-kd-mint-2 pb-2 border-b border-b-transparent hover:border-b-kd-mint-2"
                        target={link.href.startsWith("http") ? "_blank" : undefined}
                        rel={link.href.startsWith("http") ? "noopener" : undefined}
                      >
                        <span data-edit={`${k}.links.${l}.label`}>
                          {link.label}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              {certificateImage(item.cert) && viewer && (
                <button
                  type="button"
                  class="mt-16 text-ui text-kd-mint-2 pb-2 border-b border-b-transparent hover:border-b-kd-mint-2 focus-visible:border-b-kd-mint-2"
                  aria-haspopup="dialog"
                  data-cert-open={certificateImage(item.cert)?.src}
                >
                  <span data-no-edit>{viewer.view}</span>
                </button>
              )}
            </li>
            );
          })}
        </ul>
      </div>
    </section>
    {placed && section.id === slotAfter && <slot />}
    </Fragment>
  ))
}

{!placed && <slot />}

{withCertificates && viewer && <CertificateViewer labels={viewer} />}
