---
/* ============================================================
   HSE Record — /hse's site bands, between the cards and the CTA
   ------------------------------------------------------------
   Copy and shape: `hse.record` in src/data/pages.ts (OPEN-QUESTIONS.md
   #42). Each band is one surface (white / mist / ink, set in the data
   so the rhythm stays readable there) holding, in order: kicker, H2
   (with a standalone link right-aligned against it, if it has one),
   intro, then its content in one of three arrangements.

   1. TILES, THEN CARDS (the default). The media grid follows §5:
      full-bleed object-cover in a fixed box, a scrim, the caption at
      the foot. With an odd count the first tile spans the row, so
      three read as a lead and a pair. Stat tiles (ink only) follow,
      then the cards.

   2. SIDE BY SIDE (`side`). Tiles and cards share one row, a tile as
      tall as the cards beside it, so a photograph sits next to its
      account rather than a screen above it. Three or more tiles still
      lead with the first across a row of its own.

   3. THE DRILL REGISTER (cards with `media`). Each card carries its
      own photograph or clip at its head, with the card's place and
      title over it, then the body and the steps behind a toggle
      (Card.astro). Three across; with an odd number the first is the
      lead and takes the whole row, picture over two columns and its
      text, steps open, in the third. Cards without media follow in
      the same three columns, a `wide` one over two of them.

   `order` sets the order cards are shown in; their keys stay on their
   array index, so a card can move without its stored edits moving off
   it (DESIGN-SYSTEM §9).

   SYMMETRY. Every grid uses the same 24px gap, so the columns line up
   down the band, and cards in one row stretch to one height.

   VIDEO starts when it scrolls into view and pauses off screen; under
   prefers-reduced-motion it never starts and the poster frame shows.
   The script for that is Tile.astro's.
   ============================================================ */
import Kicker from "../Kicker.astro";
import Arrow from "../Arrow.astro";
import Tile from "./Tile.astro";
import Card from "./Card.astro";
import type { HseBand, HseCard } from "../../data/pages";

interface Props {
  bands: readonly HseBand[];
}

const { bands } = Astro.props;
const K = "hse.record.bands";
const surface = { white: "bg-white", mist: "bg-kd-mist", ink: "bg-kd-ink" } as const;
const lgCols = { 2: "lg:grid-cols-2", 3: "lg:grid-cols-3" } as const;
---

{
  bands.map((band, b) => {
    const ink = band.tone === "ink";
    const media = band.media ?? [];
    const cards = band.cards ?? [];
    const shown = (band.order ?? cards.map((_, i) => i)).map((i) => ({ c: cards[i] as HseCard, i }));

    /* 3. The drill register. */
    const entries = shown.filter(({ c }) => c.media);
    const plain = entries.length ? shown.filter(({ c }) => !c.media) : [];
    const leadEntry = entries.length >= 3 && entries.length % 2 === 1;

    /* 2. Side by side: [lead tile] + the rest of the tiles and the cards in one row. */
    const side = band.side === true && !entries.length;
    const leadTile = side && media.length >= 3 && media.length % 2 === 1;
    const rowCount = side ? media.length - (leadTile ? 1 : 0) + cards.length : 0;

    /* 1. Tiles, then cards. */
    const odd = media.length % 2 === 1;
    const narrow = cards.filter((c) => !c.wide).length;
    const spans = (c: HseCard) => c.wide || cards.length === 1;

    const tileKeys = (i: number) => ({ whereKey: `${K}.${b}.media.${i}.where`, titleKey: `${K}.${b}.media.${i}.title` });
    const cardKeys = (i: number) => ({ whereKey: `${K}.${b}.cards.${i}.where`, titleKey: `${K}.${b}.cards.${i}.title` });

    return (
      <section class:list={["py-96", surface[band.tone]]}>
        <div class="max-w-kd mx-auto px-24 sm:px-48">
          {band.link ? (
            <div class="flex flex-wrap items-end justify-between gap-40">
              <div>
                <Kicker label={band.kicker} editKey={`${K}.${b}.kicker`} tone={ink ? "dark" : "light"} />
                <h2
                  class:list={["font-display text-d4 mt-16", ink ? "text-kd-mist" : "text-kd-ink"]}
                  data-edit={`${K}.${b}.heading`}
                >
                  {band.heading}
                </h2>
              </div>
              <a
                href={band.link.href}
                class:list={["inline-flex items-center gap-8 text-ui shrink-0", ink ? "text-kd-mint" : "text-kd-mint-2"]}
              >
                <span data-edit={`${K}.${b}.link.label`}>{band.link.label}</span>
                <Arrow />
              </a>
            </div>
          ) : (
            <>
              <Kicker label={band.kicker} editKey={`${K}.${b}.kicker`} tone={ink ? "dark" : "light"} />
              <h2
                class:list={["font-display text-d4 mt-16", ink ? "text-kd-mist" : "text-kd-ink"]}
                data-edit={`${K}.${b}.heading`}
              >
                {band.heading}
              </h2>
            </>
          )}
          {band.intro && (
            <p
              class:list={["text-body mt-20 max-w-720", ink ? "text-kd-fog" : "text-kd-slate-2"]}
              data-edit={`${K}.${b}.intro`}
            >
              {band.intro}
            </p>
          )}

          {entries.length > 0 && (
            <ul class="grid gap-24 mt-48 sm:grid-cols-2 lg:grid-cols-3">
              {entries.map(({ c, i }, n) => {
                const k = `${K}.${b}.cards.${i}`;
                const lead = leadEntry && n === 0;
                return lead ? (
                  <li class="flex flex-col sm:col-span-2 lg:col-span-3 lg:grid lg:grid-cols-subgrid">
                    <div class="relative overflow-hidden h-265 sm:h-360 lg:h-auto lg:min-h-480 lg:col-span-2">
                      <Tile media={c.media!} where={c.where} title={c.title} {...cardKeys(i)} large width={1040} height={667} />
                    </div>
                    <Card card={c} k={k} ink={ink} head={false} open as="div" class="flex-1" />
                  </li>
                ) : (
                  <li class="flex flex-col">
                    <div class="relative overflow-hidden h-240">
                      <Tile media={c.media!} where={c.where} title={c.title} {...cardKeys(i)} width={760} height={480} />
                    </div>
                    <Card card={c} k={k} ink={ink} head={false} as="div" class="flex-1" />
                  </li>
                );
              })}
            </ul>
          )}
          {plain.length > 0 && (
            <ul class="grid gap-24 mt-24 lg:grid-cols-3">
              {plain.map(({ c, i }) => (
                <Card card={c} k={`${K}.${b}.cards.${i}`} ink={ink} class={c.wide ? "lg:col-span-2" : undefined} />
              ))}
            </ul>
          )}

          {side && (
            <ul class:list={["grid gap-24 mt-48 sm:grid-cols-2", lgCols[rowCount as 2 | 3]]}>
              {media.map((m, i) => {
                const lead = leadTile && i === 0;
                /* Alone on its row at two columns: the last of an odd run after the lead. */
                const last = !lead && i === media.length - 1 && cards.length === 0 && rowCount % 2 === 1;
                return (
                  <li
                    class:list={[
                      "relative overflow-hidden h-265",
                      lead ? "sm:col-span-2 lg:col-span-full sm:h-480" : "sm:h-auto sm:min-h-360",
                      last && "sm:max-lg:col-span-2",
                    ]}
                  >
                    <Tile
                      media={m}
                      where={m.where}
                      title={m.title}
                      {...tileKeys(i)}
                      large={lead}
                      width={lead ? 1232 : 800}
                      height={lead ? 480 : 760}
                    />
                  </li>
                );
              })}
              {shown.map(({ c, i }, n) => (
                <Card
                  card={c}
                  k={`${K}.${b}.cards.${i}`}
                  ink={ink}
                  class={n === cards.length - 1 && rowCount % 2 === 1 ? "sm:max-lg:col-span-2" : undefined}
                />
              ))}
            </ul>
          )}

          {!side && !entries.length && media.length > 0 && (
            <ul class="grid gap-24 mt-48 sm:grid-cols-2">
              {media.map((m, i) => {
                const wide = odd && i === 0;
                return (
                  <li
                    class:list={[
                      "relative overflow-hidden h-265",
                      wide ? "sm:col-span-2 sm:h-480" : "sm:h-360",
                      m.pending && "border border-dashed border-kd-card-border-light bg-kd-mist",
                    ]}
                    data-pending={m.pending ? "" : undefined}
                  >
                    {m.pending ? (
                      <div class="absolute inset-0 p-24 flex flex-col justify-end">
                        <span
                          class="self-start text-badge uppercase text-kd-ink bg-kd-badge-fill border border-kd-badge-border px-8 py-6"
                          data-edit={`${K}.${b}.media.${i}.pending`}
                        >
                          {m.pending}
                        </span>
                        <p class="text-meta-sm text-kd-slate-2 mt-16" data-edit={`${K}.${b}.media.${i}.where`}>
                          {m.where}
                        </p>
                        <p class="font-display text-d8 text-kd-ink mt-6" data-edit={`${K}.${b}.media.${i}.title`}>
                          {m.title}
                        </p>
                        <p class="text-body-sm text-kd-slate-2 mt-12" data-edit={`${K}.${b}.media.${i}.note`}>
                          {m.note}
                        </p>
                      </div>
                    ) : (
                      <Tile
                        media={m}
                        where={m.where}
                        title={m.title}
                        {...tileKeys(i)}
                        large={wide}
                        width={wide ? 1232 : 800}
                        height={480}
                      />
                    )}
                  </li>
                );
              })}
            </ul>
          )}

          {band.stats && (
            <div class="mt-48">
              <ul class="grid gap-24 grid-cols-2 lg:grid-cols-4">
                {band.stats.map((s, i) => (
                  <li class="bg-kd-stat-fill border border-kd-stat-border p-24">
                    <p class="font-display text-d5 text-kd-mint" data-edit={`${K}.${b}.stats.${i}.value`}>
                      {s.value}
                    </p>
                    <p class="text-label uppercase text-kd-slate mt-8" data-edit={`${K}.${b}.stats.${i}.label`}>
                      {s.label}
                    </p>
                  </li>
                ))}
              </ul>
              {band.statsNote && (
                <p class="text-meta-sm text-kd-fog mt-16" data-edit={`${K}.${b}.statsNote`}>
                  {band.statsNote}
                </p>
              )}
            </div>
          )}

          {!side && !entries.length && cards.length > 0 && (
            <ul
              class:list={[
                "grid gap-24 mt-48",
                narrow === 2 && "sm:grid-cols-2",
                narrow >= 3 && "sm:grid-cols-2 lg:grid-cols-3",
              ]}
            >
              {shown.map(({ c, i }) => (
                <Card
                  card={c}
                  k={`${K}.${b}.cards.${i}`}
                  ink={ink}
                  spread={spans(c)}
                  class={c.wide ? "sm:col-span-full" : undefined}
                />
              ))}
            </ul>
          )}
        </div>
      </section>
    );
  })
}

<script>
  /* Edit mode: every drill's steps open, so no editable line is out of
     sight behind a toggle the editor's click would not reach. */
  const root = document.documentElement;
  const openSteps = () => {
    if (!root.hasAttribute("data-nt-mode")) return;
    document.querySelectorAll<HTMLDetailsElement>("details[data-hse-steps]").forEach((d) => (d.open = true));
  };
  openSteps();
  new MutationObserver(openSteps).observe(root, { attributes: true, attributeFilter: ["data-nt-mode"] });
</script>
