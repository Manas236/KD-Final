---
/* ============================================================
   Projects — ink band, 704/464 grid
   ------------------------------------------------------------
   Two columns, 704fr / 464fr, 16px gap. 704 + 16 + 464 = 1184, which is
   the 1280 container less its two 48px gutters — so the fractions are
   the design's real pixel widths and the grid holds them at any width.

   Left: one featured card, 704×500. Right: two 464×265 cards stacked
   with the same 16px gap.

   Media rules (DESIGN-SYSTEM.md §5): full-bleed inside the box, always
   scrimmed, never given a corner radius, never bordered, caption at the
   foot of the box — 32px in on the large card, 20px on the small ones.

   ⚠ THE RIGHT COLUMN IS 46px TALLER THAN THE LEFT. 265 + 16 + 265 = 546
   against the featured card's 500. Both numbers are from the spec and
   they do not reconcile; see the defect list in OPEN-QUESTIONS.md #9.
   Built to the stated numbers rather than quietly stretched to match.

   EVERY CARD LINKS TO ITS OWN PAGE, same stretched-link treatment as
   projects/Listing.astro — see the note there and OPEN-QUESTIONS.md
   #21.

   MOBILE: stacks to one column below 900px — not a Tailwind default,
   but the width at which the 704px column stops fitting. See
   DESIGN-SYSTEM.md §10.
   ============================================================ */
import { Image } from "astro:assets";
import matunga from "../assets/project-matunga-workshop.jpg";
import sanpada from "../assets/project-sanpada-carshed.jpg";
import fobSpan from "../assets/project-fob-truss-span.jpg";
import { home } from "../data/home";
import { slugify } from "../lib/slug";
import Arrow from "./Arrow.astro";
import Kicker from "./Kicker.astro";

const { projects } = home;
const smallImages = [sanpada, fobSpan];
---

<section class="bg-kd-ink py-96">
  <div class="max-w-kd mx-auto px-24 sm:px-48">
    <div class="flex flex-wrap items-end justify-between gap-40">
      <div>
        <Kicker label={projects.kicker} editKey="home.projects.kicker" />
        <h2
          class="font-display text-d4 text-kd-mist mt-16"
          data-edit="home.projects.heading"
        >
          {projects.heading}
        </h2>
      </div>

      <a
        href={projects.link.href}
        class="inline-flex items-center gap-8 text-ui text-kd-mint shrink-0"
      >
        <span data-edit="home.projects.link.label">{projects.link.label}</span>
        <Arrow />
      </a>
    </div>

    <div class="grid grid-cols-1 min-[900px]:grid-cols-[704fr_464fr] gap-16 mt-56">
      <article class="relative h-500 overflow-hidden">
        <Image
          src={matunga}
          alt={projects.featured.alt}
          width={704}
          height={500}
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover object-center"
        />
        <div
          class="absolute inset-0"
          style="background-image: var(--kd-scrim-lg)"
          aria-hidden="true"
        >
        </div>
        <div class="absolute inset-x-0 bottom-0 p-32">
          <span
            class="inline-block text-badge uppercase text-kd-mist bg-kd-badge-fill border border-kd-badge-border px-8 py-6"
            data-edit="home.projects.featured.badge"
          >
            {projects.featured.badge}
          </span>
          <h3
            class="font-display text-d6 text-kd-mist mt-12"
            data-edit="home.projects.featured.title"
          >
            {projects.featured.title}
          </h3>
          <p
            class="text-meta text-kd-fog mt-6"
            data-edit="home.projects.featured.meta"
          >
            {projects.featured.meta}
          </p>
        </div>

        <a
          href={`/projects/${slugify(projects.featured.title)}`}
          class="absolute inset-0"
          aria-label={projects.featured.title}
        />
      </article>

      <div class="flex flex-col gap-16">
        {
          projects.cards.map((card, i) => (
            <article class="relative h-265 overflow-hidden">
              <Image
                src={smallImages[i]}
                alt={card.alt}
                width={464}
                height={265}
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover object-center"
              />
              <div
                class="absolute inset-0"
                style="background-image: var(--kd-scrim-sm)"
                aria-hidden="true"
              />
              <div class="absolute inset-x-0 bottom-0 p-20">
                <span
                  class="inline-block text-badge-sm uppercase text-kd-mist bg-kd-badge-fill border border-kd-badge-border px-8 py-6"
                  data-edit={`home.projects.cards.${i}.badge`}
                >
                  {card.badge}
                </span>
                <h3
                  class="font-display text-d9 text-kd-mist mt-8"
                  data-edit={`home.projects.cards.${i}.title`}
                >
                  {card.title}
                </h3>
                <p
                  class="text-meta-sm text-kd-fog mt-6"
                  data-edit={`home.projects.cards.${i}.meta`}
                >
                  {card.meta}
                </p>
              </div>

              <a
                href={`/projects/${slugify(card.title)}`}
                class="absolute inset-0"
                aria-label={card.title}
              />
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
