---
/* ============================================================
   SocialProjectPage — /projects/<slug> for a "Beyond the railway" project
   ------------------------------------------------------------
   One page per tile of the Beyond the railway band on /projects, at
   the user's request (OPEN-QUESTIONS.md #36). Rendered by
   src/pages/projects/[slug].astro when the slug is one of these rather
   than a railway project; copy in src/data/social-projects.ts.

   No design export covers it, and nothing here is a new pattern — the
   bands are the railway project page's, the tiles the Vindhane plant
   page's:

     nav (ink) -> hero (ink + image: back link, kicker, H1, location,
     four fact tiles) -> overview (white: kicker, paragraphs, then the
     gallery block exactly as ProjectDetailPage draws it) -> cta (ink,
     centred, the railway pages' own copy) -> footer (ink-deep)

   Same band order as ProjectDetailPage, so the same rhythm: one ink
   band before the ink-deep footer, no two surfaces repeated.

   WHY NOT ProjectDetailPage. Its shape is a client line, discipline
   badges and a stat grid — every field filled. These projects have a
   location and, mostly, nothing else on record; forcing them into that
   template would have meant blank client lines and invented badges.
   Here the hero carries the location under the H1 (as the plant page
   does), and the four tiles are the facts a project page needs, each
   either a figure or a placeholder.

   PENDING (review only). Drawn as the plant page draws them: on ink,
   a dashed ghost-outline border, the badge chip in mist; on white, a
   dashed light border with the chip in ink. A project with no
   photograph gets a plain ink hero and a pending tile where the
   gallery's first photograph would sit, the same 265px box.
   `data-pending` is for scripts/check-placeholders.mjs; every one is
   filled or removed before go-live (PRE-LAUNCH.md 5a–5h).

   Keys are `projects.detail.*`, as on the railway project pages —
   plain, because every page is its own path. These pages are in
   scripts/check-edit-keys.mjs, one route per slug.
   ============================================================ */
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../Nav.astro";
import SiteFooter from "../SiteFooter.astro";
import Kicker from "../Kicker.astro";
import Arrow from "../Arrow.astro";
import GalleryGrid from "../GalleryGrid.astro";
import Lightbox from "../Lightbox.astro";
import type { SocialPageCopy } from "../../data/social-projects";
import { galleryImage } from "../../lib/gallery-images";
import { home } from "../../data/home";

interface Props {
  slug: string;
  page: SocialPageCopy;
}

const { slug, page } = Astro.props;
const { detail } = page;
const K = "projects.detail";

const heroImage = detail.file ? galleryImage(detail.file) : undefined;

/* The nav's own label for /projects as the middle crumb — see the same
   note in ProjectDetailPage.astro. */
const projectsLabel = home.nav.links.find((l) => l.href === "/projects")?.label ?? "Projects";
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: projectsLabel, path: "/projects" },
  { name: detail.title, path: `/projects/${slug}` },
];

const chip = "inline-block text-badge uppercase px-8 py-6 bg-kd-badge-fill border border-kd-badge-border";
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  image={heroImage}
  imageAlt={heroImage ? detail.alt : undefined}
  breadcrumbs={breadcrumbs}
>
  <Nav page="projects" />
  <main>
    <section class="relative bg-kd-ink overflow-hidden">
      {heroImage && (
        <div class="absolute inset-0" aria-hidden="true">
          <Image
            src={heroImage}
            alt={detail.alt ?? detail.title}
            width={1551}
            height={700}
            loading="eager"
            fetchpriority="high"
            class="w-full h-full object-cover object-center"
            style="opacity: var(--kd-hero-image-opacity)"
          />
          <div class="absolute inset-0" style="background-image: var(--kd-hero-overlay)"></div>
        </div>
      )}

      <div class="relative max-w-kd mx-auto px-24 sm:px-48 pt-144 pb-80">
        <div class="w-568 max-w-full">
          <a href="/projects" class="inline-flex items-center gap-8 text-ui text-kd-fog">
            <span aria-hidden="true">←</span>
            <span data-edit={`${K}.backLabel`}>{detail.backLabel}</span>
          </a>

          <div class="mt-24">
            <Kicker label={detail.eyebrow} editKey={`${K}.eyebrow`} />
          </div>

          <h1 class="font-display text-d3 min-[900px]:text-d1 text-kd-mist mt-16" data-edit={`${K}.title`}>
            {detail.title}
          </h1>

          <p class="text-body-lg text-kd-mist mt-24" data-edit={`${K}.location`}>
            {detail.location}
          </p>

          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-16 mt-56">
            {detail.facts.map((fact, i) =>
              fact.pending ? (
                <div class="border border-dashed border-kd-ghost-outline p-24 flex flex-col" data-pending>
                  <span class:list={[chip, "self-start text-kd-mist"]} data-edit={`${K}.facts.${i}.pending`}>
                    {fact.pending}
                  </span>
                  <dt class="font-display text-d8 text-kd-mist mt-16" data-edit={`${K}.facts.${i}.title`}>
                    {fact.title}
                  </dt>
                  <dd class="text-body-sm text-kd-fog mt-8" data-edit={`${K}.facts.${i}.body`}>
                    {fact.body}
                  </dd>
                </div>
              ) : (
                <div class="bg-kd-stat-fill border border-kd-stat-border p-24">
                  <dd class="font-display text-d5 text-kd-mint" data-edit={`${K}.facts.${i}.value`}>
                    {fact.value}
                  </dd>
                  <dt class="text-label uppercase text-kd-slate mt-8" data-edit={`${K}.facts.${i}.label`}>
                    {fact.label}
                  </dt>
                </div>
              )
            )}
          </dl>
        </div>
      </div>
    </section>

    <section class="bg-white py-96">
      <div class="max-w-kd mx-auto px-24 sm:px-48">
        <Kicker label={detail.overviewKicker} editKey={`${K}.overviewKicker`} tone="light" />

        <div class="mt-32 max-w-560 flex flex-col gap-20">
          {detail.notes.map((note, i) => (
            <div class="border border-dashed border-kd-card-border-light p-24" data-pending>
              <span class:list={[chip, "text-kd-ink"]} data-edit={`${K}.notes.${i}.pending`}>
                {note.pending}
              </span>
              <h2 class="font-display text-d8 text-kd-ink mt-16" data-edit={`${K}.notes.${i}.title`}>
                {note.title}
              </h2>
              <p class="text-body-sm text-kd-slate-2 mt-8" data-edit={`${K}.notes.${i}.body`}>
                {note.body}
              </p>
            </div>
          ))}
          {detail.body.map((paragraph, i) => (
            <p class="text-body-sm text-kd-slate-2" data-edit={`${K}.body.${i}`}>
              {paragraph}
            </p>
          ))}
        </div>

        <div class="mt-56 pt-56 border-t border-kd-divider-light">
          <Kicker label={detail.galleryKicker} editKey={`${K}.galleryKicker`} tone="light" />
          <div class="mt-32">
            {detail.gallery.length > 0 ? (
              <GalleryGrid project={detail.title} photos={detail.gallery} group={slug} keyPrefix={`${K}.gallery`} />
            ) : (
              detail.photoNote && (
                <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-16">
                  <li
                    class="h-265 border border-dashed border-kd-card-border-light p-20 flex flex-col"
                    data-pending
                  >
                    <span class:list={[chip, "self-start text-kd-ink"]} data-edit={`${K}.photoNote.pending`}>
                      {detail.photoNote.pending}
                    </span>
                    <h3 class="font-display text-d8 text-kd-ink mt-16" data-edit={`${K}.photoNote.title`}>
                      {detail.photoNote.title}
                    </h3>
                    <p class="text-body-sm text-kd-slate-2 mt-8" data-edit={`${K}.photoNote.body`}>
                      {detail.photoNote.body}
                    </p>
                  </li>
                </ul>
              )
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-kd-ink py-96">
      <div class="max-w-kd mx-auto px-24 sm:px-48 flex flex-col items-center text-center">
        <Kicker label={detail.ctaKicker} editKey={`${K}.ctaKicker`} variant="centred" />

        <h2 class="font-display text-d4 min-[900px]:text-d2 text-kd-mist mt-24" data-edit={`${K}.ctaHeadline`}>
          {detail.ctaHeadline}
        </h2>

        <a
          href="/projects"
          class="inline-flex items-center gap-8 text-ui-lg bg-kd-mint text-kd-ink-deep px-32 py-16 mt-40"
        >
          <span data-edit={`${K}.ctaButton`}>{detail.ctaButton}</span>
          <Arrow />
        </a>
      </div>
    </section>

    {detail.lightbox && <Lightbox labels={detail.lightbox} keyPrefix={`${K}.lightbox`} />}
  </main>
  <SiteFooter page="projects" />
</BaseLayout>
