---
/* ============================================================
   The section eyebrow
   ------------------------------------------------------------
   Every band opens with one. Two variants and no third — see
   DESIGN-SYSTEM.md §3.

     left    a 32×1px mint rule, 12px gap, then the label.
     centred a rule on BOTH sides of the label, the row centred. Used
             by the closing CTA and nothing else on this page.

   The rule is a <span>, not an <hr>: it is a graphic mark beside a
   label, not a thematic break between two passages of content, and an
   <hr> here would announce a section change to a screen reader that is
   in the middle of one.

   TONE. `--kd-mint` on a mist or white band is ~1.2:1 — invisible, per
   OPEN-QUESTIONS.md #1. `tone="light"` swaps both the rule and the
   label to `--kd-mint-2`, the darker same-hue variant that clears WCAG
   AA on those bands. Every caller already knows its own band from its
   own header comment; it just has to say so.
   ============================================================ */
interface Props {
  /** The eyebrow text. */
  label: string;
  /** Its declared slot key, e.g. "home.about.kicker". */
  editKey: string;
  /** `centred` puts a rule on each side. */
  variant?: "left" | "centred";
  /** `light` on a mist/white band, where pure mint is invisible. */
  tone?: "dark" | "light";
}

const { label, editKey, variant = "left", tone = "dark" } = Astro.props;
const mintBg = tone === "light" ? "bg-kd-mint-2" : "bg-kd-mint";
const mintText = tone === "light" ? "text-kd-mint-2" : "text-kd-mint";
---

<div
  class:list={[
    "flex items-center gap-12",
    variant === "centred" && "justify-center",
  ]}
>
  <span class:list={["block w-32 h-1 shrink-0", mintBg]} aria-hidden="true"></span>
  <span class:list={["text-kicker uppercase", mintText]} data-edit={editKey}>{label}</span>
  {
    variant === "centred" && (
      <span class:list={["block w-32 h-1 shrink-0", mintBg]} aria-hidden="true" />
    )
  }
</div>
