---
/* ============================================================
   BaseLayout
   ------------------------------------------------------------
   The document shell: head, fonts, and the two script tags that mount
   the in-page editor. Everything visible on a page comes through the
   <slot />.

   The editor half of this file is PORTED FROM NESTING TREE and frozen —
   see the long note above the head script.
   ============================================================ */
import "../styles/global.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { CACHE_PREFIX } from "../lib/editable";
import { shareRendition } from "../lib/share-image";
import { isNoindexDeployment } from "../lib/staging";
import { organization } from "../data/organization";
import logo from "../assets/kd-logo-mint.jpg";

/* The two font files each family actually needs, imported so Vite
   fingerprints them and hands back the built URL. Preloading them is
   what keeps the type from swapping in after first paint and shoving
   the layout down — the hero H1 is 72px Fraunces and is the largest
   thing on the page, so a late swap there is the whole viewport moving.

   latin-ext is preloaded as well as latin, and it is not optional: the
   rupee sign U+20B9 lives in the latin-ext subset of BOTH families, and
   it is in the hero stats (Fraunces) and every project meta line
   (Inter). Preload latin alone and the one glyph that carries the
   money reflows a beat after everything else. */
import frauncesLatin from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import frauncesLatinExt from "@fontsource-variable/fraunces/files/fraunces-latin-ext-wght-normal.woff2?url";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import interLatinExt from "@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url";

interface Props {
  title: string;
  /** The share title (og:title), for a page whose tab title is shorter
      than what a shared link should say. Omitted, it is `title`. */
  ogTitle?: string;
  description: string;
  /** Keep this page out of the search index. */
  noindex?: boolean;
  /** The share card — what WhatsApp, LinkedIn and search show beside
      a link to this page. A page's own hero photograph, where it has
      one; a page that passes none gets the designed 1200×630 card. */
  image?: ImageMetadata;
  /** The photograph's alt text, for og:image:alt. Every page that passes
      an `image` passes this too; the designed card carries its own. */
  imageAlt?: string;
  /** Home → … → this page, for the BreadcrumbList a search result
      shows in place of the raw URL. Only pages below the top level
      pass one; the last crumb is the page itself. */
  breadcrumbs?: readonly { name: string; path: string }[];
  /** A project page's main photograph, for the WebPage block's
      primaryImageOfPage: the hero, at the size the hero draws it, so the
      URL is the one already in the page. `credit` is false for a picture
      that is not K.D.'s own photograph (a representative image, an
      architect's rendering): the block then names no creator. */
  primaryImage?: {
    image: ImageMetadata;
    width: number;
    height: number;
    caption: string;
    credit: boolean;
  };
}

const { title, ogTitle = title, description, noindex = false, image, imageAlt, breadcrumbs, primaryImage } = Astro.props;

/* One address per page. "/about/" answers too (src/middleware.ts sends
   it to "/about" with a 301), so the canonical drops a trailing slash
   rather than repeating whichever form was asked for. */
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, "") || "/", Astro.site);

/* ---------- Share card ----------
   A page's own photograph, as a 1200 × 630 JPEG crop of it made for
   link previews (src/lib/share-image.ts), with the size actually served
   written into og:image:width/height. A page with no photograph
   (/contact, /privacy, a project still waiting for its picture) gets
   the designed card instead: public/share-card.png, the logo and the
   company name, written by scripts/build-share-card.mjs. So every link
   to the site previews with a picture.

   Absolute either way, because og:image must be, and built on
   Astro.site (PUBLIC_SITE_URL), so it follows the site to whatever
   origin it is deployed on. */
const CARD = {
  src: "/share-card.png",
  width: 1200,
  height: 630,
  type: "image/png",
  alt: `${organization.name} logo and company name`,
};
const photo = image ? await shareRendition(image) : null;
const share = photo
  ? {
      url: new URL(photo.src, Astro.site).href,
      width: photo.width,
      height: photo.height,
      type: "image/jpeg",
      alt: imageAlt,
    }
  : { url: new URL(CARD.src, Astro.site).href, width: CARD.width, height: CARD.height, type: CARD.type, alt: CARD.alt };

/* ---------- Robots ----------
   A noindex page (the 404, the studio) says so and names no canonical:
   there is no address of its own to point a search engine at. Every
   other page asks for large image previews, except on a test deployment
   (SITE_NOINDEX=1), where the X-Robots-Tag header already says noindex
   on every response (src/middleware.ts) and the page adds nothing. */
const largePreviews = !noindex && !isNoindexDeployment();

/* ---------- Structured data ----------
   JSON-LD blocks, per docs/SEO.md "Schema recommendations":

   Organization, on EVERY page. The facts are src/data/organization.ts,
   which reads what it can from home.footer, /contact and /hse so they
   cannot drift; its header says what is withheld and why. The logo is
   the nav's.

   WebSite, on the homepage only, naming the Organization as its
   publisher: what a search result shows as the site's name.

   BreadcrumbList, on pages that pass `breadcrumbs`. A search result
   for a project page then reads "Home › Projects › Sanpada Carshed"
   rather than the URL.

   WebPage, on pages that pass `primaryImage` (the project pages): the
   page and its main photograph, an ImageObject. A K.D. photograph names
   K.D. as creator and credit; a representative image or a rendering does
   not, and its caption says what it is.

   Serialised with `<\\/` escaped: a "</script>" inside a JSON string
   would end the tag early. */
const logoUrl = new URL((await getImage({ src: logo, width: logo.width })).src, Astro.site).href;
const organizationId = new URL("/#organization", Astro.site).href;
const websiteId = new URL("/#website", Astro.site).href;

const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": organizationId,
  name: organization.name,
  legalName: organization.legalName,
  url: Astro.site?.href,
  logo: logoUrl,
  foundingDate: organization.foundingDate,
  foundingLocation: organization.foundingLocation,
  slogan: organization.slogan,
  address: { "@type": "PostalAddress", ...organization.address },
  telephone: organization.telephone,
  email: organization.email,
  contactPoint: { "@type": "ContactPoint", ...organization.contactPoint },
  sameAs: organization.sameAs,
  memberOf: { "@type": "Organization", name: organization.memberOf },
  areaServed: organization.areaServed,
  hasCredential: organization.credentials.map((c) => ({
    "@type": "EducationalOccupationalCredential",
    name: c.name,
    ...(c.description && { description: c.description }),
    credentialCategory: "certification",
    identifier: c.number,
    ...(c.issuer && { recognizedBy: { "@type": "Organization", name: c.issuer } }),
    ...(c.validUntil && { expires: c.validUntil }),
  })),
};

const websiteLd = canonical.pathname === "/" && {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  url: Astro.site?.href,
  name: organization.name,
  alternateName: organization.legalName,
  inLanguage: "en-IN",
  publisher: { "@id": organizationId },
};

const primary = primaryImage
  ? await getImage({ src: primaryImage.image, width: primaryImage.width, height: primaryImage.height })
  : null;
const webPageLd = primaryImage &&
  primary && {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${canonical.href}#webpage`,
    url: canonical.href,
    name: title,
    description,
    inLanguage: "en-IN",
    isPartOf: { "@id": websiteId },
    primaryImageOfPage: {
      "@type": "ImageObject",
      /* No width or height: a photograph narrower than the size the hero
         asks for is served smaller (never enlarged), so a stated size
         could be wrong. */
      contentUrl: new URL(primary.src, Astro.site).href,
      caption: primaryImage.caption,
      ...(primaryImage.credit && {
        creator: { "@id": organizationId },
        creditText: organization.name,
        copyrightNotice: organization.name,
      }),
    },
  };

const breadcrumbLd = breadcrumbs && {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((crumb, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: crumb.name,
    item: new URL(crumb.path, Astro.site).href,
  })),
};

const jsonLd = (value: unknown) => JSON.stringify(value).replace(/<\//g, "<\\/");

/* ---------- In-page text editing ----------
   PORTED FROM NESTING TREE (src/layouts/BaseLayout.astro). The feature
   is injected here and only here, as two script tags.

   1. An inline head script. It has to be inline, in the head, ahead of
      everything: it starts the fetch for this page's saved text while
      the rest of the document is still being parsed, and it paints the
      copy already cached in localStorage the moment the DOM exists —
      which is before the deferred editor runs, so returning visitors do
      not watch the built-in text flip to the edited text.

      It also owns the two things both halves have to agree on: how an
      element's edit_key is read, and how text is normalised before
      comparing. The editor imports neither — it calls back into
      window.__ntEdit, so there is exactly one implementation of each.

   2. A bundled module script at the end of the body: the gestures, the
      toolbar and saving, none of which the first paint needs.

   THE TWO HALVES ARE NOT GATED THE SAME WAY, and that asymmetry is the
   whole design.

   Part 1 is the READ path and runs for everybody, always. It is what
   paints the edited copy, so gating it would show the public the text
   the site was built with rather than the text it now says. On Nesting
   Tree this was gated by mistake for a while, and the result was that
   an edit was visible to the person who made it and to nobody else.

   Part 2 is the editor, and it is downloaded only by a browser holding
   the `kd_edit_ui=1` hint cookie that /api/edit-session sets at
   sign-in. Written as a dynamic import so the editor becomes a chunk of
   its own: an ordinary visitor does not fetch a byte of it, sees no
   button, and has nothing on the page to suggest one exists.

   That cookie is a HINT and nothing more. It is not HttpOnly, anybody
   can set it by hand, and all that earns them is a downloaded script
   whose every save is refused — the write routes check the signed
   `kd_edit` cookie instead, which is the real gate (src/lib/edit-auth.ts).
   Never make a server-side decision from `kd_edit_ui`.

   WHAT CHANGED FROM NESTING TREE. One thing, and it is the reason the
   port happened now rather than later:

     keyFor() no longer WALKS the DOM to spell a positional
     `tag:nth-of-type(n)` path. It reads the `data-edit` attribute the
     author wrote. elFor() looks an element up by that attribute rather
     than by querySelector on a path.

   Three things fall out of that, and all three are deletions:

     · ensureWrapped() and the <nt-t> wrapper machinery are gone. They
       existed so that a run of copy sharing its parent with a <br> or a
       <strong> could be given an element of its own for a positional
       path to land on. With declared slots the author gives it one by
       putting data-edit on it, so there is nothing to infer and nothing
       to inject. The function survives as a no-op because the frozen
       editor script calls it.
     · applyOne()'s fallback scan is gone. It hunted the document for
       an element still holding the text an edit replaced, because a
       positional key stops pointing at the right node the moment the
       markup moves. A named key does not move, so the hunt has nothing
       to add and could only ever write an edit onto the wrong element.
     · applyOne() no longer refuses to paint when the element's current
       text differs from the row's `original_text`. That guard is what
       made a copy rewrite orphan every edit under a key. The key is the
       identity now; `original_text` is an audit note about what the
       page said at the time, not a latch.

   The prose lives up here rather than beside the tags because an inline
   script followed by a MULTI-LINE HTML comment does not survive the
   Astro compiler — it reports "Unexpected token" and fails the build.
   Keep any comment down there to a single line. */

/* ---------- Motion ----------
   Two more tags, same split as the editor's. src/styles/motion.css has
   the whole of it.

   1. An inline head script puts `kd-motion` on <html> before the body
      is parsed. Every rule in motion.css hangs off that class, so with
      no script the page renders exactly as it did before motion was
      added, and the homepage hero's fade is in place from first paint
      rather than flashing in after it. Left off on /studio/*, and when
      a signed-in editor's last page was in edit mode (inline-edit.js
      keeps that in sessionStorage as "kd-edit-mode" and restores it),
      so editable copy is never hidden or moving under the editor.

   2. A bundled script at the end of the body, src/scripts/reveal.js:
      the scroll reveal. It runs after the page's own scripts, so on
      /projects#gallery the filter has already opened its tab and
      scrolled before the reveal looks at what is on screen. */
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {largePreviews && <meta name="robots" content="max-image-preview:large" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={organization.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={share.url} />
    <meta property="og:image:type" content={share.type} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    {share.alt && <meta property="og:image:alt" content={share.alt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={share.url} />
    {share.alt && <meta name="twitter:image:alt" content={share.alt} />}

    <!-- The KD monogram on mint, cut from the logo by scripts/build-favicon.mjs. -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={jsonLd(organizationLd)} />
    {websiteLd && <script type="application/ld+json" set:html={jsonLd(websiteLd)} />}
    {breadcrumbLd && <script type="application/ld+json" set:html={jsonLd(breadcrumbLd)} />}
    {webPageLd && <script type="application/ld+json" set:html={jsonLd(webPageLd)} />}

    <link rel="preload" as="font" type="font/woff2" href={frauncesLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={frauncesLatinExt} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interLatinExt} crossorigin />

    <link rel="stylesheet" href="/editor-ui.css" />

    <!-- Motion switch: src/styles/motion.css plays only under html.kd-motion. See the note in the frontmatter. -->
    <script is:inline>
      (function () {
        try {
          var path = location.pathname;
          if (path === "/studio" || path.indexOf("/studio/") === 0) return;
          var editor = document.cookie.split("; ").indexOf("kd_edit_ui=1") !== -1;
          if (editor && sessionStorage.getItem("kd-edit-mode") === "1") return;
          document.documentElement.classList.add("kd-motion");
        } catch (e) {
          /* no class, no motion: the page is simply static */
        }
      })();
    </script>

    <!-- In-page text editing, part 1 of 2. See the note in the frontmatter. -->
    <script is:inline define:vars={{ NT_CACHE_PREFIX: CACHE_PREFIX }}>
      window.__ntEdit = (function () {
        /* Written as escapes rather than literals: these characters are
           invisible in an editor, and a mangled one fails silently. */
        var RE_NBSP = new RegExp("\u00a0", "g");
        var RE_ZERO_WIDTH = new RegExp("[\u200b-\u200d\ufeff]", "g");

        /* Same shape the server stores: lower case, no trailing slash. */
        var path = location.pathname.split("?")[0].split("#")[0].toLowerCase();
        if (path.length > 1) path = path.replace(/\/+$/, "");
        if (!path) path = "/";

        var cacheKey = NT_CACHE_PREFIX + path;

        /* Mirrors normalizeText() in src/lib/editable.ts. Markup wraps
           copy across source lines, so this is what makes "does this
           element still hold the text we think it does?" answerable. */
        function normalize(s) {
          return String(s == null ? "" : s)
            .replace(RE_NBSP, " ")
            .replace(RE_ZERO_WIDTH, "")
            .replace(/[\r\n\t]+/g, " ")
            .replace(/\s{2,}/g, " ")
            .trim();
        }

        function textOf(el) {
          return normalize(el.textContent);
        }

        /* Editable means one text node and nothing else: a leaf holding
           a single run of words. Anything richer would lose its children
           the moment we assigned textContent. */
        function isTextLeaf(el) {
          return (
            el.childNodes.length === 1 &&
            el.firstChild.nodeType === 3 &&
            normalize(el.firstChild.nodeValue) !== ""
          );
        }

        function setText(el, t) {
          el.textContent = t;
        }

        /* Tags whose text is not copy, and the blocks the markup has
           opted out by hand. Kept because the frozen editor calls both. */
        var SKIP_TAGS =
          " SCRIPT STYLE SVG INPUT TEXTAREA SELECT OPTION IFRAME " +
          "NOSCRIPT CANVAS VIDEO AUDIO IMG BR HR TEMPLATE ";
        var OPT_OUT = "svg, [data-nt-ui], [data-no-edit], [aria-hidden='true']";

        function skipTag(el) {
          return SKIP_TAGS.indexOf(" " + el.tagName + " ") !== -1;
        }

        /* A no-op. Nesting Tree wrapped loose runs of copy in <nt-t> so a
           positional key had an element to land on; a declared slot is
           already on an element. Kept because inline-edit.js calls it. */
        function ensureWrapped() {}

        /* THE KEY IS DECLARED, NOT COMPUTED. */
        function keyFor(el) {
          return (el && el.getAttribute && el.getAttribute("data-edit")) || "";
        }

        function elFor(key) {
          if (!key) return null;
          try {
            var safe =
              window.CSS && CSS.escape ? CSS.escape(key) : key.replace(/"/g, "");
            return document.body.querySelector('[data-edit="' + safe + '"]');
          } catch (e) {
            return null;
          }
        }

        function place(el, key, text, original) {
          /* The anchor is what the page said when the edit was made. It
             is recorded, not matched on. See the frontmatter note. */
          if (!el.dataset.ntOriginal) el.dataset.ntOriginal = original;
          el.dataset.ntKey = key;
          el.dataset.ntApplied = text;
          el.setAttribute("data-nt-edited", "");
          setText(el, text);
          return el;
        }

        /* Find the slot; write to it. There is no second guess and no
           fallback scan: a named key either names an element on this
           page or it names one that has been retired, and writing a
           retired key's text onto some other element that happens to
           match a string is exactly the accident this design removes. */
        function applyOne(key, text, original) {
          if (!text) return null;
          var el = elFor(key);
          if (!el || !isTextLeaf(el)) return null;
          return place(el, key, text, original);
        }

        function applyAll(map) {
          var n = 0;
          if (!map) return n;
          for (var key in map) {
            if (!Object.prototype.hasOwnProperty.call(map, key)) continue;
            var e = map[key];
            if (e && applyOne(key, e.text, e.original)) n++;
          }
          return n;
        }

        function readCache() {
          try {
            return JSON.parse(localStorage.getItem(cacheKey) || "{}") || {};
          } catch (e) {
            return {};
          }
        }

        function writeCache(map) {
          try {
            localStorage.setItem(cacheKey, JSON.stringify(map || {}));
          } catch (e) {
            /* private mode, or the quota is full: the page still works */
          }
        }

        /* Off before the parser has even reached the body. Never cached. */
        var ready = fetch("/api/content?path=" + encodeURIComponent(path), {
          credentials: "same-origin",
          headers: { Accept: "application/json" },
        })
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .catch(function () {
            return null;
          });

        /* readystatechange -> "interactive" fires once the document is
           parsed and BEFORE deferred scripts run, so the cached copy is
           on screen by the time the editor boots. */
        function whenParsed(fn) {
          if (document.readyState !== "loading") return fn();
          document.addEventListener("readystatechange", function onState() {
            if (document.readyState === "loading") return;
            document.removeEventListener("readystatechange", onState);
            fn();
          });
        }

        function applyCache() {
          applyAll(readCache());
        }
        whenParsed(applyCache);

        /* THE READ PATH. This is what puts the saved text on the page for
           every visitor, and it must stay in this ungated head script.

           The cache pass above is only a head start for a browser that
           has been here before; localStorage is per-origin and empty for
           everybody else. A null answer means offline or a database that
           is down: leave the cached copy alone rather than snapping the
           page back to the built-in text. */
        function applyServer(data) {
          if (!data || !data.edits) return;
          applyAll(data.edits);
          writeCache(data.edits);
        }

        /* Resolves once the server's answer is ON the page, which needs
           both the fetch and a parsed document: whichever lands second
           does the work. The editor awaits this rather than `ready` so
           the text is applied in exactly one place. */
        var applied = ready.then(function (data) {
          return new Promise(function (resolve) {
            whenParsed(function () {
              applyServer(data);
              resolve(data);
            });
          });
        });

        return {
          path: path,
          cacheKey: cacheKey,
          normalize: normalize,
          textOf: textOf,
          isTextLeaf: isTextLeaf,
          setText: setText,
          skipTag: skipTag,
          optOut: OPT_OUT,
          ensureWrapped: ensureWrapped,
          keyFor: keyFor,
          elFor: elFor,
          applyOne: applyOne,
          applyAll: applyAll,
          readCache: readCache,
          writeCache: writeCache,
          ready: ready,
          applied: applied,
        };
      })();
    </script>
  </head>
  <body>
    <slot />

    <!-- Scroll reveal: blocks below the fold fade up once as they arrive. See the frontmatter. -->
    <script>
      import "../scripts/reveal.js";
    </script>

    <!-- In-page text editing, part 2 of 2: the editor, for signed-in browsers only. See the frontmatter. -->
    <script>
      if (document.cookie.split("; ").some((c) => c === "kd_edit_ui=1")) {
        import("../scripts/inline-edit.js");
      }
    </script>
  </body>
</html>
