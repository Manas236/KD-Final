---
/* ============================================================
   Homepage
   ------------------------------------------------------------
   The band stack, in the approved order. The alternation is the design
   — nav (ink) → hero (ink + image) → about (mist) → capabilities
   (white) → projects (ink) → differentiators (mist) → closing CTA (ink)
   → footer (ink-deep) — and no two adjacent bands share a surface
   except the nav and the hero, which read as one dark opening.

   Each band paints its own surface and holds its own 1280px container,
   so this file is a list and nothing else. Nothing here decides
   anything; if you are adding layout to this page, it belongs in the
   section component.
   ============================================================ */
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Capabilities from "../components/Capabilities.astro";
import Projects from "../components/Projects.astro";
import Differentiators from "../components/Differentiators.astro";
import ClosingCta from "../components/ClosingCta.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { home } from "../data/home";
/* The share card: the Nhava Sheva aerial. It was the hero's backdrop
   until the Uran loop replaced it (2026-10-15) and stayed the share
   picture, so its alt text is its own (home.meta.shareAlt), not the
   hero's. */
import shareImage from "../assets/hero-nhava-sheva-station.jpg";

export const prerender = false;
---

<BaseLayout
  title={home.meta.title}
  ogTitle={home.meta.ogTitle}
  description={home.meta.description}
  image={shareImage}
  imageAlt={home.meta.shareAlt}
>
  <Nav overlay />
  <main>
    <Hero />
    <About />
    <Capabilities />
    <Projects />
    <Differentiators />
    <ClosingCta />
  </main>
  <SiteFooter />
</BaseLayout>
