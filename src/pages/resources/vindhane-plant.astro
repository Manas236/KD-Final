---
/* ============================================================
   /resources/vindhane-plant — the Vindhane steel fabrication plant
   ------------------------------------------------------------
   Added at the user's request — see OPEN-QUESTIONS.md #33. The plant
   card on /projects (#31) linked to /resources, where the plant is one
   card in a two-item list; the user asked why it had no page of its
   own and, shown how peer contractors present an owned plant, chose a
   standalone page. No design export covers it; every band is an
   existing pattern:

     nav (ink) -> hero (ink + image, /projects/[slug]'s three-layer
     construction, back link, kicker, H1, stat tiles) -> overview
     (white: Story.astro's kicker/paragraph shape with the plant's clip
     beside it as an /hse clip tile, then two pairs of hairline lists,
     then the gallery block exactly as [slug] draws it) ->
     erection & proof (ink: the steel ledger's rows, each linking to
     its project page, closing on a button) -> footer (ink-deep)

   The last band is ink and carries the page's button, so there is no
   separate CTA band: Overview (white) -> Erection (ink) -> Footer
   (ink-deep) alternates, and a centred CTA band after Erection would
   be ink on ink (DESIGN-SYSTEM §2). Same shape every page ends on —
   the band before the footer is ink.

   PENDING TILES (review only). The figures a facility page leads with
   — capacity, area, year, machine counts — were placeholders until
   2026-10-24, when the plant in-charge gave them all (OPEN-QUESTIONS.md
   #65, #66); none is on the page now, and the branch stays for the
   next one. A placeholder is a `pending` item in
   src/data/plant.ts, drawn here
   the way projects/Social.astro draws them on ink (dashed ghost
   outline, the badge chip carrying the label, the ask in the body)
   and the way InfoPage.astro draws them on white (dashed card border,
   the chip in ink). `data-pending` is for scripts/check-placeholders.mjs;
   every one is filled or removed before go-live (OPEN-QUESTIONS.md #32,
   PRE-LAUNCH.md).

   KEYS are `resources.plant.*` — Nav and SiteFooter take page="resources"
   and write `resources.nav.*` / `resources.footer.*`, so the whole page
   sits under one prefix and the gate compares it against the `plant`
   export of src/data/plant.ts. Registered in scripts/check-edit-keys.mjs,
   scripts/check-placeholders.mjs and src/lib/editable.ts.
   ============================================================ */
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Kicker from "../../components/Kicker.astro";
import Arrow from "../../components/Arrow.astro";
import GalleryGrid from "../../components/GalleryGrid.astro";
import Lightbox from "../../components/Lightbox.astro";
import Tile from "../../components/hse/Tile.astro";
import heroImg from "../../assets/project-vindhane-plant.jpg";
import { home } from "../../data/home";
import { plant as copy } from "../../data/plant";
import { slugify } from "../../lib/slug";
import { livePlantPhotos, liveState } from "../../lib/gallery-live";

export const prerender = false;

const { plant } = copy;
/* Live photographs: gallery.ts with the studio gallery manager's changes. */
const photos = livePlantPhotos(await liveState(), "/resources/vindhane-plant");
const K = "resources.plant";

/* Breadcrumb trail for search results — see BaseLayout's Props. The
   middle crumb is the nav's own label for /about, at /about itself:
   Resources is a section of that page since 21 Oct 2026, and a crumb's
   address is a page, not a fragment of one. The back link on the page
   still says "Resources" and goes to the section. */
const aboutLabel = home.nav.links.find((l) => l.href === "/about")?.label ?? "About";
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: aboutLabel, path: "/about" },
  { name: plant.title, path: "/resources/vindhane-plant" },
];
const chip = "inline-block text-badge uppercase px-8 py-6 bg-kd-badge-fill border border-kd-badge-border";

/* The first pair's rows, column by column (OPEN-QUESTIONS.md #66):
   "What the plant makes" draws its own rows and then the machinery rows
   its `machineryRows` names; "How it is equipped" draws the rest in its
   `order`. A row's key comes from the list and index it is stored at,
   so a row drawn in the other column, or higher up, keeps its key. */
const columns = [
  {
    list: "products" as const,
    rows: [
      ...plant.products.items.map((_, i) => ({ list: "products" as const, i })),
      ...plant.products.machineryRows.map((i) => ({ list: "machinery" as const, i })),
    ],
  },
  {
    list: "machinery" as const,
    rows: plant.machinery.order.map((i) => ({ list: "machinery" as const, i })),
  },
];
/* From 900px a column is a subgrid of its pair's grid, spanning the
   number of the pair's rows its own --rows says. */
const column = "min-[900px]:grid min-[900px]:grid-rows-subgrid min-[900px]:row-span-(--rows)";
const figureRow = "border-t border-t-kd-divider-light py-16 flex items-baseline justify-between gap-16 text-body-sm";
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  image={heroImg}
  imageAlt={plant.alt}
  breadcrumbs={breadcrumbs}
>
  <Nav page="resources" />
  {/* data-print and data-no-print: the printed page, src/styles/print.css. */}
  <main id="main" data-print>
    <section class="relative bg-kd-ink overflow-hidden">
      <div class="absolute inset-0" aria-hidden="true">
        <Image
          src={heroImg}
          alt={plant.alt}
          width={1551}
          height={700}
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover object-center"
          style="opacity: var(--kd-hero-image-opacity)"
        />
        <div class="absolute inset-0" style="background-image: var(--kd-hero-overlay)"></div>
      </div>

      <div class="relative max-w-kd mx-auto px-24 sm:px-48 pt-144 pb-80">
        <div class="w-568 max-w-full">
          <a href="/about#resources" class="inline-flex items-center gap-8 text-ui text-kd-fog" data-no-print>
            <span aria-hidden="true" data-arrow="back">←</span>
            <span data-edit={`${K}.backLabel`}>{plant.backLabel}</span>
          </a>

          <div class="mt-24">
            <Kicker label={plant.eyebrow} editKey={`${K}.eyebrow`} />
          </div>

          <h1 class="font-display text-d3 max-sm:text-[length:clamp(var(--text-d5),10vw,var(--text-d3))] max-sm:leading-[1.15] min-[900px]:text-d1 text-kd-mist mt-16" data-edit={`${K}.title`}>
            {plant.title}
          </h1>

          <p class="text-body-lg text-kd-mist mt-24" data-edit={`${K}.location`}>
            {plant.location}
          </p>

          <div class="flex items-center gap-8 mt-16">
            {plant.badges.map((badge, i) => (
              <span class:list={[chip, "text-kd-mist"]} data-edit={`${K}.badges.${i}`}>
                {badge}
              </span>
            ))}
          </div>

          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-16 mt-56">
            {plant.stats.map((stat, i) =>
              stat.pending ? (
                <div
                  class="border border-dashed border-kd-ghost-outline p-24 flex flex-col"
                  data-pending
                >
                  {/* The chip is part of the term, so the <dl> holds only
                      <dt> and <dd>; the <dt> draws no box (`contents`),
                      so chip and title sit in the tile as before. */}
                  <dt class="contents">
                    <span class:list={[chip, "self-start text-kd-mist"]} data-edit={`${K}.stats.${i}.pending`}>
                      {stat.pending}
                    </span>
                    <span class="font-display text-d8 text-kd-mist mt-16" data-edit={`${K}.stats.${i}.title`}>
                      {stat.title}
                    </span>
                  </dt>
                  <dd class="text-body-sm text-kd-fog mt-8" data-edit={`${K}.stats.${i}.body`}>
                    {stat.body}
                  </dd>
                </div>
              ) : (
                <div class="bg-kd-stat-fill border border-kd-stat-border p-24">
                  <dd class="font-display text-d5 text-kd-mint" data-edit={`${K}.stats.${i}.value`}>
                    {stat.value}
                  </dd>
                  <dt class="text-label uppercase text-kd-slate mt-8" data-edit={`${K}.stats.${i}.label`}>
                    {stat.label}
                  </dt>
                </div>
              )
            )}
          </dl>
        </div>
      </div>
    </section>

    <section class="bg-white py-96">
      <div class="max-w-kd mx-auto px-24 sm:px-48">
        <Kicker label={plant.overviewKicker} editKey={`${K}.overviewKicker`} tone="light" />

        {/* The paragraphs, and from 1024px the plant's own clip beside
            them, in the right-hand column of the lists' grid below so
            the two halves line up down the band. Its box keeps the
            clip's own 640 × 368, so nothing is cropped. Narrower, it
            follows the paragraphs at full width. */}
        <div class="mt-32 grid grid-cols-1 lg:grid-cols-2 gap-x-32 gap-y-32 items-start">
          <div class="max-w-560 flex flex-col gap-20">
            {plant.body.map((paragraph, i) => (
              <p class="text-body-sm text-kd-slate-2" data-edit={`${K}.body.${i}`}>
                {paragraph}
              </p>
            ))}
          </div>
          <div class="relative overflow-hidden aspect-[640/368]">
            <Tile
              media={plant.clip}
              where={plant.clip.where}
              title={plant.clip.title}
              whereKey={`${K}.clip.where`}
              titleKey={`${K}.clip.title`}
              width={640}
              height={368}
            />
          </div>
        </div>

        {/* Hairline lists in two pairs, the steel ledger's row grammar
            on a light band: one line per item on a divider, no bullets.
            What the plant makes beside how it is equipped, then its
            covered areas beside its team, those two with the figure on
            the right and a total. From 900px each pair is one grid and
            each column a subgrid of it, so the nth rows of the two
            columns share a track and their rules line up, even where one
            of them wraps. Narrower, the columns stack, 48px apart
            (OPEN-QUESTIONS.md #66). */}
        <div class="mt-56 pt-56 border-t border-kd-divider-light grid grid-cols-1 min-[900px]:grid-cols-2 gap-x-32 gap-y-48 min-[900px]:gap-y-0">
          {columns.map(({ list, rows }) => (
            <div class={column} style={`--rows: ${rows.length + 1}`}>
              <h2 class="text-label uppercase text-kd-slate pb-16" data-edit={`${K}.${list}.head`}>
                {plant[list].head}
              </h2>
              <ul class={column} style={`--rows: ${rows.length}`}>
                {rows.map(({ list: from, i }) => {
                  const item = plant[from].items[i];
                  const k = `${K}.${from}.items.${i}`;
                  return item.pending ? (
                    <li
                      class="border border-dashed border-kd-card-border-light p-24 mt-16"
                      data-pending
                    >
                      <span class:list={[chip, "text-kd-ink"]} data-edit={`${k}.pending`}>
                        {item.pending}
                      </span>
                      <h3 class="font-display text-d8 text-kd-ink mt-16" data-edit={`${k}.title`}>
                        {item.title}
                      </h3>
                      <p class="text-body-sm text-kd-slate-2 mt-8" data-edit={`${k}.body`}>
                        {item.body}
                      </p>
                    </li>
                  ) : (
                    <li
                      class="border-t border-t-kd-divider-light py-16 text-body-sm text-kd-slate-2"
                      data-edit={`${k}.text`}
                    >
                      {item.text}
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>

        <div class="mt-48 grid grid-cols-1 min-[900px]:grid-cols-2 gap-x-32 gap-y-48 min-[900px]:gap-y-0">
          {(["areas", "team"] as const).map((list) => {
            const { head, items, total } = plant[list];
            const note = list === "team" ? plant.team.note : undefined;
            const rows = [
              ...items.map((row, i) => ({ row, k: `${K}.${list}.items.${i}`, total: false })),
              { row: total, k: `${K}.${list}.total`, total: true },
            ];
            return (
              <div class={column} style={`--rows: ${rows.length + (note ? 2 : 1)}`}>
                <h2 class="text-label uppercase text-kd-slate pb-16" data-edit={`${K}.${list}.head`}>
                  {head}
                </h2>
                <dl class={column} style={`--rows: ${rows.length}`}>
                  {rows.map(({ row, k, total }) => (
                    <div class:list={[figureRow, total ? "text-kd-ink" : "text-kd-slate-2"]}>
                      <dt data-edit={`${k}.label`}>{row.label}</dt>
                      <dd class="shrink-0 whitespace-nowrap tabular-nums" data-edit={`${k}.value`}>
                        {row.value}
                      </dd>
                    </div>
                  ))}
                </dl>
                {note && (
                  <p class="border-t border-t-kd-divider-light pt-16 text-label-sm text-kd-slate" data-edit={`${K}.${list}.note`}>
                    {note}
                  </p>
                )}
              </div>
            );
          })}
        </div>

        <div class="mt-56 pt-56 border-t border-kd-divider-light">
          <Kicker label={plant.galleryKicker} editKey={`${K}.galleryKicker`} tone="light" />
          <div class="mt-32">
            <GalleryGrid
              project={plant.title}
              photos={photos}
              group="vindhane-plant"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="bg-kd-ink py-96">
      <div class="max-w-kd mx-auto px-24 sm:px-48">
        <Kicker label={plant.erection.kicker} editKey={`${K}.erection.kicker`} />
        <h2 class="font-display text-d4 min-[900px]:text-d2 text-kd-mist mt-16" data-edit={`${K}.erection.heading`}>
          {plant.erection.heading}
        </h2>
        <p class="text-body text-kd-fog mt-20 max-w-720" data-edit={`${K}.erection.body`}>
          {plant.erection.body}
        </p>

        <div class="bg-kd-stat-fill border border-kd-stat-border p-32 mt-48">
          <h3 class="text-label uppercase text-kd-slate" data-edit={`${K}.erection.ledgerHead`}>
            {plant.erection.ledgerHead}
          </h3>
          <ul class="grid grid-cols-1 min-[900px]:grid-cols-2 gap-x-32 mt-24">
            {plant.erection.items.map((row, i) => (
              <li class="border-t border-t-kd-stat-border">
                <a
                  href={`/projects/${slugify(row.title)}`}
                  class="flex items-baseline justify-between gap-16 py-16"
                >
                  <span class="flex flex-col">
                    <span class="text-ui text-kd-mist" data-edit={`${K}.erection.items.${i}.title`}>
                      {row.title}
                    </span>
                    <span class="text-meta-sm text-kd-fog mt-6" data-edit={`${K}.erection.items.${i}.label`}>
                      {row.label}
                    </span>
                  </span>
                  <span class="font-display text-d8 text-kd-mint shrink-0" data-edit={`${K}.erection.items.${i}.figure`}>
                    {row.figure}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <a
          href={plant.erection.button.href}
          class="inline-flex items-center gap-8 text-ui-lg bg-kd-mint text-kd-ink-deep px-32 py-16 mt-40"
          data-no-print
        >
          <span data-edit={`${K}.erection.button.label`}>{plant.erection.button.label}</span>
          <Arrow />
        </a>
      </div>
    </section>

    <Lightbox labels={plant.lightbox} keyPrefix={`${K}.lightbox`} />
  </main>
  <SiteFooter page="resources" />
</BaseLayout>
