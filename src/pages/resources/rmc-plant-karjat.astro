---
/* ============================================================
   /resources/rmc-plant-karjat — the Karjat ready-mix concrete plant
   ------------------------------------------------------------
   Added at the user's request on 2026-09-28, the sibling of
   vindhane-plant.astro and drawn with the same bands:

     nav (ink) -> hero (ink, back link, kicker, H1, stat tiles) ->
     overview (white: paragraphs, two hairline lists, gallery) ->
     closing (ink, with the page's button) -> footer (ink-deep)

   NO PHOTOGRAPH YET. The hero is plain ink until the plant photos are
   processed; then import the hero here the way vindhane-plant.astro
   does and add the three-layer image block. The gallery shows a
   dashed `pending` card while `rmc.gallery` is empty.

   KEYS are `resources.rmc.*`. Registered in scripts/check-edit-keys.mjs,
   scripts/check-placeholders.mjs and src/lib/editable.ts.
   ============================================================ */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Kicker from "../../components/Kicker.astro";
import Arrow from "../../components/Arrow.astro";
import GalleryGrid from "../../components/GalleryGrid.astro";
import Lightbox from "../../components/Lightbox.astro";
import { rmcPlant as copy } from "../../data/rmc-plant";

export const prerender = false;

const { rmc } = copy;
const K = "resources.rmc";

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: rmc.backLabel, path: "/resources" },
  { name: rmc.title, path: "/resources/rmc-plant-karjat" },
];
const chip = "inline-block text-badge uppercase px-8 py-6 bg-kd-badge-fill border border-kd-badge-border";
---

<BaseLayout title={copy.meta.title} description={copy.meta.description} breadcrumbs={breadcrumbs}>
  <Nav page="resources" />
  <main>
    <section class="relative bg-kd-ink overflow-hidden">
      <div class="relative max-w-kd mx-auto px-24 sm:px-48 pt-144 pb-80">
        <div class="w-568 max-w-full">
          <a href="/resources" class="inline-flex items-center gap-8 text-ui text-kd-fog">
            <span aria-hidden="true">←</span>
            <span data-edit={`${K}.backLabel`}>{rmc.backLabel}</span>
          </a>

          <div class="mt-24">
            <Kicker label={rmc.eyebrow} editKey={`${K}.eyebrow`} />
          </div>

          <h1 class="font-display text-d3 min-[900px]:text-d1 text-kd-mist mt-16" data-edit={`${K}.title`}>
            {rmc.title}
          </h1>

          <p class="text-body-lg text-kd-mist mt-24" data-edit={`${K}.location`}>
            {rmc.location}
          </p>

          <div class="flex items-center gap-8 mt-16">
            {rmc.badges.map((badge, i) => (
              <span class:list={[chip, "text-kd-mist"]} data-edit={`${K}.badges.${i}`}>
                {badge}
              </span>
            ))}
          </div>

          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-16 mt-56">
            {rmc.stats.map((stat, i) =>
              stat.pending ? (
                <div class="border border-dashed border-kd-ghost-outline p-24 flex flex-col" data-pending>
                  <span class:list={[chip, "self-start text-kd-mist"]} data-edit={`${K}.stats.${i}.pending`}>
                    {stat.pending}
                  </span>
                  <dt class="font-display text-d8 text-kd-mist mt-16" data-edit={`${K}.stats.${i}.title`}>
                    {stat.title}
                  </dt>
                  <dd class="text-body-sm text-kd-fog mt-8" data-edit={`${K}.stats.${i}.body`}>
                    {stat.body}
                  </dd>
                </div>
              ) : (
                <div class="bg-kd-stat-fill border border-kd-stat-border p-24">
                  <dd class="font-display text-d5 text-kd-mint" data-edit={`${K}.stats.${i}.value`}>
                    {stat.value}
                  </dd>
                  <dt class="text-label uppercase text-kd-slate mt-8" data-edit={`${K}.stats.${i}.label`}>
                    {stat.label}
                  </dt>
                </div>
              )
            )}
          </dl>
        </div>
      </div>
    </section>

    <section class="bg-white py-96">
      <div class="max-w-kd mx-auto px-24 sm:px-48">
        <Kicker label={rmc.overviewKicker} editKey={`${K}.overviewKicker`} tone="light" />

        <div class="mt-32 max-w-560 flex flex-col gap-20">
          {rmc.body.map((paragraph, i) => (
            <p class="text-body-sm text-kd-slate-2" data-edit={`${K}.body.${i}`}>
              {paragraph}
            </p>
          ))}
        </div>

        <div class="mt-56 pt-56 border-t border-kd-divider-light grid grid-cols-1 min-[900px]:grid-cols-2 gap-x-32 gap-y-48">
          {(["supplies", "equipment"] as const).map((list) => (
            <div>
              <h2 class="text-label uppercase text-kd-slate" data-edit={`${K}.${list}.head`}>
                {rmc[list].head}
              </h2>
              <ul class="mt-16">
                {rmc[list].items.map((item, i) =>
                  item.pending ? (
                    <li class="border border-dashed border-kd-card-border-light p-24 mt-16" data-pending>
                      <span class:list={[chip, "text-kd-ink"]} data-edit={`${K}.${list}.items.${i}.pending`}>
                        {item.pending}
                      </span>
                      <h3 class="font-display text-d8 text-kd-ink mt-16" data-edit={`${K}.${list}.items.${i}.title`}>
                        {item.title}
                      </h3>
                      <p class="text-body-sm text-kd-slate-2 mt-8" data-edit={`${K}.${list}.items.${i}.body`}>
                        {item.body}
                      </p>
                    </li>
                  ) : (
                    <li
                      class="border-t border-t-kd-divider-light py-16 text-body-sm text-kd-slate-2"
                      data-edit={`${K}.${list}.items.${i}.text`}
                    >
                      {item.text}
                    </li>
                  )
                )}
              </ul>
            </div>
          ))}
        </div>

        <div class="mt-56 pt-56 border-t border-kd-divider-light">
          <Kicker label={rmc.galleryKicker} editKey={`${K}.galleryKicker`} tone="light" />
          <div class="mt-32">
            {rmc.gallery.length > 0 && (
              <GalleryGrid project={rmc.title} photos={rmc.gallery} group="rmc-plant" keyPrefix={`${K}.gallery`} />
            )}
            <div class="border border-dashed border-kd-card-border-light p-24 max-w-560" data-pending>
              <span class:list={[chip, "text-kd-ink"]} data-edit={`${K}.galleryPending.pending`}>
                {rmc.galleryPending.pending}
              </span>
              <h3 class="font-display text-d8 text-kd-ink mt-16" data-edit={`${K}.galleryPending.title`}>
                {rmc.galleryPending.title}
              </h3>
              <p class="text-body-sm text-kd-slate-2 mt-8" data-edit={`${K}.galleryPending.body`}>
                {rmc.galleryPending.body}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-kd-ink py-96">
      <div class="max-w-kd mx-auto px-24 sm:px-48">
        <Kicker label={rmc.closing.kicker} editKey={`${K}.closing.kicker`} />
        <h2 class="font-display text-d4 min-[900px]:text-d2 text-kd-mist mt-16" data-edit={`${K}.closing.heading`}>
          {rmc.closing.heading}
        </h2>
        <p class="text-body text-kd-fog mt-20 max-w-720" data-edit={`${K}.closing.body`}>
          {rmc.closing.body}
        </p>
        <a
          href={rmc.closing.button.href}
          class="inline-flex items-center gap-8 text-ui-lg bg-kd-mint text-kd-ink-deep px-32 py-16 mt-40"
        >
          <span data-edit={`${K}.closing.button.label`}>{rmc.closing.button.label}</span>
          <Arrow />
        </a>
      </div>
    </section>

    <Lightbox labels={rmc.lightbox} keyPrefix={`${K}.lightbox`} />
  </main>
  <SiteFooter page="resources" />
</BaseLayout>
