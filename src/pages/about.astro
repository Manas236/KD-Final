---
/* ============================================================
   /about
   ------------------------------------------------------------
   The band stack, in the order the design export gives it:

     nav (ink) → hero (ink + image) → story (white) → journey (mist)
     → vision (white) → philosophy (ink) → board (white) → HSE (ink)
     → CTA (ink) → footer (ink-deep)

   ONE OF THOSE BOUNDARIES BREAKS THE BAND RHYTHM in DESIGN-SYSTEM §2 —
   HSE → CTA is ink on ink. What the export draws, built as drawn, and
   written up in OPEN-QUESTIONS.md #17 with the one-word fix it would
   take. The journey → board violation #17 also flagged (mist then
   white, two light bands running together) no longer exists: vision
   and philosophy — new bands with no export behind them, added per
   OPEN-QUESTIONS.md #20 — sit between them as white then ink, which
   restores the alternation on both sides rather than breaking it
   further. See #20.

   ONE PAGE SINCE 21 OCT 2026, at Sir's request (OPEN-QUESTIONS.md #58):
   the pages under the About menu follow About's own bands as sections,
   Company, Capabilities, Resources, Clients, CSR, each opening on ink
   with what was its hero (about/PageSection.astro, aboutSections in
   src/data/pages.ts), and About's own CTA closes the page. So the stack
   is now

     hero → story (white) → journey (mist) → vision (white)
     → philosophy (ink) → HSE (mist) → [ink header, white, mist...] × 5
     → CTA (ink) → footer (ink-deep)

   The board band is retired (the directors are in the Company section,
   with their portraits), and the HSE band turned mist, #17's fix, since
   otherwise philosophy, HSE and the Company header would be three ink
   bands in a row. Every boundary now changes surface.

   `page="about"` on the chrome is not decoration: it is the first
   segment of every slot key the nav and the footer write, so the nav's
   labels are `about.nav.*` here and `home.nav.*` on the homepage. See
   the note at the top of src/data/about.ts. The merged sections keep
   their own prefixes (`company.*`, `clients.*`...).

   Each band paints its own surface and holds its own 1280px container,
   so this file is a list and nothing else.
   ============================================================ */
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/about/Hero.astro";
import Story from "../components/about/Story.astro";
import Journey from "../components/about/Journey.astro";
import Vision from "../components/about/Vision.astro";
import Philosophy from "../components/about/Philosophy.astro";
import Board from "../components/about/Board.astro";
import Hse from "../components/about/Hse.astro";
import PageSection from "../components/about/PageSection.astro";
import Cta from "../components/about/Cta.astro";
import { about } from "../data/about";
import { aboutSections } from "../data/pages";
/* The hero's backdrop, doubling as the share card — the same file
   components/about/Hero.astro draws. */
import shareImage from "../assets/about-mankhurd-workforce.jpg";

export const prerender = false;
---

<BaseLayout
  title={about.meta.title}
  ogTitle={about.meta.ogTitle}
  description={about.meta.description}
  image={shareImage}
  imageAlt={about.hero.backdropAlt}
>
  <Nav page="about" />
  <main>
    <Hero />
    <Story />
    <Journey />
    <Vision />
    <Philosophy />
    <Board />
    <Hse />
    {aboutSections.map(({ id, page, copy }) => <PageSection id={id} page={page} copy={copy} />)}
    <Cta />
  </main>
  <SiteFooter page="about" />
</BaseLayout>
