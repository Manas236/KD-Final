---
/* ============================================================
   GET /studio/applications — every application sent from /careers
   ------------------------------------------------------------
   Each one is also emailed to HR through Resend once it is saved
   (src/lib/application-mail.ts); this page is the copy that does not
   depend on the email arriving, and the only place to find an
   application that came in before email was set up, or while Resend was
   refusing it. The Email column reads job_applications.mail_status:
   Sent (with Resend's id), Not sent (with the reason, or "email is not
   set up"), or Not recorded (before 2026-11-11, or the result could not
   be saved). Its data-mail attribute is what check:db-flows reads.

   Each row has id="application-<id>": the email's link lands on it.

   The header links to /studio/enquiries, the enquiries from /contact,
   and that page links back here (12 Nov 2026).

   SIGNED-IN EDITORS ONLY: anyone else gets the bodyless 404 the other
   studio pages give (see the note at the top of studio/gallery.astro).
   Editor tooling, so its strings live here, not in a copy module, and
   it reuses the gallery manager's header styles.

   DELETE: each row has a Delete button (two clicks: Delete, then
   Confirm), which is how HR honours a deletion request under /privacy.
   Opening the page also deletes anything past RETENTION_MONTHS, the
   other promise that policy makes (src/lib/applications.ts).
   ============================================================ */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isAuthed } from "../../lib/edit-auth";
import { RETENTION_MONTHS, listApplications, purgeExpired, type MailState } from "../../lib/applications";
import { careersInbox, mailConfigured } from "../../lib/mailer";

export const prerender = false;

if (!isAuthed(Astro.request)) {
  return new Response(null, { status: 404, headers: { "X-Astro-Error": "true" } });
}

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Cache-Control", "no-store");

await purgeExpired();
const apps = await listApplications();
const mailOn = mailConfigured();
const when = (d: Date) =>
  d.toLocaleString("en-IN", {
    timeZone: "Asia/Kolkata",
    day: "numeric",
    month: "short",
    year: "numeric",
    hour: "numeric",
    minute: "2-digit",
  });
const size = (b: number) => (b >= 1024 * 1024 ? `${(b / 1024 / 1024).toFixed(1)} MB` : `${Math.ceil(b / 1024)} KB`);
const mailNote = (m: MailState): string =>
  m.status === "sent"
    ? m.detail
      ? `Resend id ${m.detail}`
      : ""
    : m.status === "skipped"
      ? m.detail === "dry run"
        ? "Dry run, printed to the log"
        : "Email is not set up"
      : m.detail;
---

<BaseLayout title="Applications | K.D. Constructions" description="Job applications sent from the careers page." noindex skip={false}>
  <link rel="stylesheet" href="/gallery-manager.css" />
  <main class="gm">
    <header class="gm-top">
      <div class="gm-top-inner">
        <div class="gm-title">
          <span class="gm-kicker">K.D. Constructions · Studio</span>
          <h1>Job applications</h1>
        </div>
        <div class="gm-actions">
          <a class="gm-btn" href="/studio/enquiries">Enquiries</a>
          <a class="gm-btn gm-btn-primary" href="/careers">View the careers page</a>
        </div>
      </div>
    </header>

    <section class="gm-help">
      {
        mailOn ? (
          <p>
            Every application sent from the careers page is kept here and emailed to{" "}
            <strong>{careersInbox()}</strong> with the resume attached. The Email column says whether it went. If
            one shows <strong>Not sent</strong>, the reason is under it, and the application and resume are still
            here.
          </p>
        ) : (
          <p>
            <strong>Email is not set up yet</strong>, so applications are only kept here and are not being sent
            to {careersInbox()}. Once the Resend key is added to the server, new applications are emailed too.
          </p>
        )
      }
      <p>
        Applications are deleted automatically {RETENTION_MONTHS} months after they arrive, as the{" "}
        <a href="/privacy">privacy policy</a> says. If an applicant asks for their data to be removed, use{" "}
        <strong>Delete</strong> on their row. It removes the details and the resume from this server. The copy
        in the HR mailbox has to be deleted there by hand.
      </p>
    </section>

    {apps === null && <div class="gm-banner" role="alert">Could not read the applications from the database.</div>}

    {
      apps && apps.length === 0 && (
        <section class="gm-help">
          <p>No applications yet.</p>
        </section>
      )
    }

    {
      apps && apps.length > 0 && (
        <div class="ja-wrap">
          <table class="ja">
            <thead>
              <tr>
                <th>Received</th>
                <th>Applicant</th>
                <th>Role</th>
                <th>Message</th>
                <th>Resume</th>
                <th>Email</th>
                <th><span class="sr-only">Delete</span></th>
              </tr>
            </thead>
            <tbody>
              {apps.map((a) => (
                <tr id={`application-${a.id}`}>
                  <td class="ja-nowrap">{when(a.at)}</td>
                  <td>
                    <strong>{a.name}</strong>
                    <br />
                    <a href={`mailto:${a.email}`}>{a.email}</a>
                    <br />
                    <a href={`tel:${a.phone.replace(/[^+\d]/g, "")}`}>{a.phone}</a>
                  </td>
                  <td>{a.role}</td>
                  <td class="ja-msg">{a.message}</td>
                  <td class="ja-nowrap">
                    <a href={`/api/applications/resume?file=${encodeURIComponent(a.file)}`}>Download</a>
                    <br />
                    <span class="ja-dim">{a.file.split(".").pop()!.toUpperCase()} · {size(a.bytes)}</span>
                  </td>
                  <td class="ja-mail" data-mail={a.mail.status}>
                    {a.mail.status === "sent" ? "Sent" : a.mail.status === "none" ? "Not recorded" : <strong>Not sent</strong>}
                    {mailNote(a.mail) && (
                      <>
                        <br />
                        <span class="ja-dim ja-note">{mailNote(a.mail)}</span>
                      </>
                    )}
                  </td>
                  <td>
                    <button type="button" class="ja-del" data-delete={a.id}>Delete</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </main>
</BaseLayout>

<script>
  /* Two clicks: Delete arms the button, Confirm sends. The row goes
     once the server says the row and the resume are gone. */
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-delete]")) {
    btn.addEventListener("click", async () => {
      if (btn.dataset.armed !== "1") {
        btn.dataset.armed = "1";
        btn.textContent = "Confirm delete";
        setTimeout(() => {
          if (btn.isConnected && !btn.disabled) {
            btn.dataset.armed = "";
            btn.textContent = "Delete";
          }
        }, 5000);
        return;
      }
      btn.disabled = true;
      btn.textContent = "Deleting…";
      try {
        const res = await fetch("/api/applications/delete", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: Number(btn.dataset.delete) }),
        });
        if (res.ok || res.status === 404) {
          btn.closest("tr")?.remove();
          return;
        }
        const { error } = await res.json().catch(() => ({ error: "Could not delete." }));
        btn.textContent = error || "Could not delete.";
      } catch {
        btn.textContent = "Could not delete. Check the connection.";
      }
      btn.disabled = false;
      btn.dataset.armed = "";
    });
  }
</script>

<style>
  .ja-wrap {
    /* relative: the containing block of the header's sr-only "Delete",
       which otherwise escaped this scroller and made the whole page
       852px wide on a phone */
    position: relative;
    overflow-x: auto;
    padding: 0 var(--kd-gap-24) var(--kd-gap-56);
    max-width: var(--kd-container);
    margin: 0 auto;
  }
  .ja {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--kd-ink);
    background-color: white;
  }
  .ja th,
  .ja td {
    text-align: left;
    vertical-align: top;
    padding: var(--kd-gap-12) var(--kd-gap-16);
    border-bottom: var(--kd-hairline) solid var(--kd-card-border-light);
  }
  .ja th {
    font-size: var(--text-kicker);
    letter-spacing: var(--text-kicker--letter-spacing);
    text-transform: uppercase;
    color: var(--kd-slate-2);
  }
  .ja a {
    color: var(--kd-mint-2);
  }
  .ja-nowrap {
    white-space: nowrap;
  }
  .ja-msg {
    /* the table scrolls sideways on a phone; without the floor the
       message was squeezed to ~100px and every row grew 230px tall */
    min-width: 14rem;
    max-width: 360px;
    white-space: pre-wrap;
  }
  .ja tbody tr {
    scroll-margin-top: 160px;
  }
  .ja tbody tr:target {
    background-color: var(--kd-mist);
  }
  .ja-mail {
    min-width: 7rem;
    max-width: 14rem;
  }
  .ja-note {
    font-size: var(--text-meta-sm);
    line-height: var(--text-meta-sm--line-height);
    overflow-wrap: anywhere;
  }
  .ja-del {
    font: inherit;
    color: var(--kd-ink);
    background: none;
    border: var(--kd-hairline) solid var(--kd-card-border-light);
    padding: 4px var(--kd-gap-12);
    cursor: pointer;
    max-width: 220px;
    text-align: left;
  }
  .ja-del[data-armed="1"] {
    border-color: var(--kd-ink);
    font-weight: 700;
  }
  .ja-dim {
    color: var(--kd-slate-2);
  }
</style>
