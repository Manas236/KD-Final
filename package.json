{
  "name": "kd-construction",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "start": "node dist/server/entry.mjs",
    "build:release": "npm run check:site-url && npm run check:placeholders && astro build",
    "check:site-url": "node scripts/check-site-url.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:keys": "node scripts/check-edit-keys.mjs",
    "check:keys:about": "node scripts/check-edit-keys.mjs \"\" /about",
    "check:keys:projects": "node scripts/check-edit-keys.mjs \"\" /projects",
    "check:cls": "node scripts/check-layout-shift.mjs",
    "check:cls:about": "node scripts/check-layout-shift.mjs \"\" /about",
    "check:cls:projects": "node scripts/check-layout-shift.mjs \"\" /projects",
    "check:editor": "node scripts/probe-editor.mjs",
    "check:shift-cause": "node scripts/diagnose-shift.mjs",
    "fonts:measure": "node scripts/measure-font-fallbacks.mjs",
    "logos:build": "node scripts/build-client-logos.mjs",
    "favicon:build": "node scripts/build-favicon.mjs",
    "media:scan": "node scripts/raw-media-manifest.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "dotenv": "^17.4.2",
    "mysql2": "^3.24.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
