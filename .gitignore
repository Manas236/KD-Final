# server backups belong in /srv/kd-backups/, never in the site folder
# (PRE-LAUNCH.md, "Deploy and migration order"); these keep a stray one out of
# git. .npm/ and .config/ are per-user caches and settings that land there too
.env.bak*
dist.bak-*/
db-backup-*.sql
kd-schema-*.sql
.npm/
.config/

# dated copies taken next to a file before editing it (name.bak.YYYYMMDD-HHMM)
*.bak.*

# local database dumps taken on the development PC before a pass
/backups/

# certificate scans as received (scripts/build-certificates.mjs reads them
# and writes only watermarked copies into src/assets/certificates/); the
# originals are never committed and never served
/ISO_Certificates/
/Tax_Certificate/
/CIDCO_Certificate/
/PWD_Licence/
